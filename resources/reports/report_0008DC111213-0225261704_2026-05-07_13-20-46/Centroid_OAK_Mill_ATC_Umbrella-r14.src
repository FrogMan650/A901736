;#############################################################################
;                         Program Start
;#############################################################################

;=============================================================================
                          WatchDogStage
;=============================================================================

; Handle PLC executor faults. The only way to reset a PLC executor fault
; is to reboot the MPU11.
IF SV_PLC_FAULT_STATUS != 0
  THEN PLC_Fault_W    = SV_PLC_FAULT_STATUS,
       PLCFaultAddr_W = SV_PLC_FAULT_ADDRESS,
       FaultMsg_W    = PLC_EXECUTOR_FLT_MSG_C, MSG FaultMsg_W,
       SET PLCExecutorFault_M, RST MessageStage, SET SV_STOP

; Handle software exit.
IF !SV_PC_SOFTWARE_READY && (SV_PLC_FAULT_STATUS == 0)
  THEN SET SoftwareNotReady_M,
       SET SV_STOP,
       FaultMsg_W = SOFTWARE_EXIT_MSG_C
IF FaultMsg_W == 9985 && !SV_STOP THEN FaultMsg_W = MSG_CLEARED_MSG_C

IF SV_PC_SOFTWARE_READY && (SV_PLC_FAULT_STATUS == 0)
  THEN RST SoftwareNotReady_M

; If the memory bit we call "True" is not yet true, it is because this is
; the first scan after power up.  In that case execute InitialStage.
IF !True_M THEN SET InitialStage

;=============================================================================
                          InitialStage
;=============================================================================
IF 1==1 THEN SET True_M,
             SET OnAtPowerUp_M,
             SET AxesEnableStage,
             SET MainStage,
             SET JogPanelStage,
             SET LoadParametersStage,
             SET SafetySwitchInterruptStage,
             SET PLCBus_Oe_M,
             RST DriveComFltIn_M,
             RST DriveComFltOut_M,
             RST PLCFault_M,
             CycloneStatus_T = 300,
             FaultMsg_W = MSG_CLEARED_MSG_C,
             RST BadMsgStage,
             SET MessageStage,
             Initialize_T = 1000, SET Initialize_T,
             ErrorFlag_T = 1000,
             MsgClear_T = 1000,
             UsbMpgWheelStopped_T = 250,
             RST InitialStage
			 
IF 1==1 THEN CarouselPosition_W = SV_ATC_CAROUSEL_POSITION,
             RequestedBinPosition_W = CarouselPosition_W,
             PutBackPosition_W = SV_ATC_TOOL_IN_SPINDLE,
             LastCarouselDir_W = SV_NV_W1,
             SET MonitorIndexATCRequestStage,
             SET ReportCarouselPositionStage,
             SET ResetCarouselStage

;=============================================================================
                      LoadParametersStage
;=============================================================================

; There are two methods of control for the lube pump and they are set by CNC11
; Machine Parameter 179, where the value is between 0 - 65535 and is formatted
; as MMMSS where MMM is a time in minutes and SS is a time in seconds.
;
; METHOD 1 (SS == 0) For lube pumps with internal timers.
; METHOD 2 (SS != 0) For lube pumps with no timers (controlled soley by PLC).
;
; Load lube pump times from P179 and convert to milliseconds.
IF True_M THEN Lube_W = SV_MACHINE_PARAMETER_179,
             LubeM_W = (Lube_W / 100) * 60000,
             LubeS_W = (Lube_W % 100) * 1000

;Set MPG Settings
IF SV_MACHINE_PARAMETER_218 == 0 THEN SET MPGStage, RST WirelessMpgStage
IF SV_MACHINE_PARAMETER_218 > 0 THEN RST MPGStage, SET WirelessMpgStage
IF SV_MACHINE_PARAMETER_348 == 15 THEN (MPG_M)
IF (SV_MACHINE_PARAMETER_348 != 15 && SV_MACHINE_PARAMETER_348 > 0) || 
  SV_MACHINE_PARAMETER_351 > 0 || SV_MACHINE_PARAMETER_354 > 0 || SV_MACHINE_PARAMETER_470 > 0 ||
  SV_MACHINE_PARAMETER_473 > 0 || SV_MACHINE_PARAMETER_476 > 0 || SV_MACHINE_PARAMETER_479 > 0 ||
  SV_MACHINE_PARAMETER_482 > 0 || SV_MACHINE_PARAMETER_485 > 0
  THEN (HandWheel_M)
IF True_M THEN PValue_W = SV_MACHINE_PARAMETER_19
IF True_M THEN BITTST PValue_W 1 MpgX100LockOut_M

;Rapid Rate Override Enable
IF True_M THEN PValue_W = SV_MACHINE_PARAMETER_264
IF True_M THEN BITTST PValue_W 0 RapidRateOverrideEnabled_M
IF True_M THEN BITTST PValue_W 2 UsingLinkedFeature_M

;Get Status of Usb Panels
IF True_M THEN ExtUsbPanelStatus_W = SV_PC_EXT_USB_PANEL_ONLINE_BITS
IF True_M THEN WTB ExtUsbPanelStatus_W ExtUsbPanel1Online_M 4

;Set ExternalUsb Stage if a panel is detected
IF ExtUsbPanel1Online_M || ExtUsbPanel2Online_M || ExtUsbPanel3Online_M ||
  ExtUsbPanel4Online_M THEN SET CheckExternalUSBPanelStage

; Set the appropriate stage according to method of control
IF LubeS_W == 0 THEN SET LubeUsePumpTimersStage, RST LubeUsePLCTimersStage
IF LubeS_W != 0 THEN SET LubeUsePLCTimersStage, RST LubeUsePumpTimersStage

IF True_M THEN P146Value_W = SV_MACHINE_PARAMETER_146,	; Feed hold threshold
			   P148Value_W = SV_MACHINE_PARAMETER_148,	; Misc Jogging Options
			   P170Value_W = SV_MACHINE_PARAMETER_170	; Enable Keyboard Jogging


; The following section allows cnc11 to invert or override Inputs and 
; Outputs.
IF True_M THEN (SV_ENABLE_IO_OVERRIDE),
               SV_INVERT_INP1_16_BITS      = SV_MACHINE_PARAMETER_911,
               SV_INVERT_INP17_32_BITS     = SV_MACHINE_PARAMETER_912,
               SV_INVERT_INP33_48_BITS     = SV_MACHINE_PARAMETER_913,
               SV_INVERT_INP49_64_BITS     = SV_MACHINE_PARAMETER_914,
               SV_INVERT_INP65_80_BITS     = SV_MACHINE_PARAMETER_915,
               SV_FORCE_INP1_16_BITS       = SV_MACHINE_PARAMETER_916,
               SV_FORCE_INP17_32_BITS      = SV_MACHINE_PARAMETER_917,
               SV_FORCE_INP33_48_BITS      = SV_MACHINE_PARAMETER_918,
               SV_FORCE_INP49_64_BITS      = SV_MACHINE_PARAMETER_919,
               SV_FORCE_INP65_80_BITS      = SV_MACHINE_PARAMETER_920,
               SV_FORCE_ON_OUT1_16_BITS    = SV_MACHINE_PARAMETER_921,
               SV_FORCE_ON_OUT17_32_BITS   = SV_MACHINE_PARAMETER_922,
               SV_FORCE_ON_OUT33_48_BITS   = SV_MACHINE_PARAMETER_923,
               SV_FORCE_ON_OUT49_64_BITS   = SV_MACHINE_PARAMETER_924,
               SV_FORCE_ON_OUT65_80_BITS   = SV_MACHINE_PARAMETER_925,
               SV_FORCE_OFF_OUT1_16_BITS   = SV_MACHINE_PARAMETER_926,
               SV_FORCE_OFF_OUT17_32_BITS  = SV_MACHINE_PARAMETER_927,
               SV_FORCE_OFF_OUT33_48_BITS  = SV_MACHINE_PARAMETER_928,
               SV_FORCE_OFF_OUT49_64_BITS  = SV_MACHINE_PARAMETER_929,
               SV_FORCE_OFF_OUT65_80_BITS  = SV_MACHINE_PARAMETER_930,
               SV_FORCE_ON_MEM1_16_BITS    = SV_MACHINE_PARAMETER_931,
               SV_FORCE_ON_MEM17_32_BITS   = SV_MACHINE_PARAMETER_932,
               SV_FORCE_ON_MEM33_48_BITS   = SV_MACHINE_PARAMETER_933,
               SV_FORCE_ON_MEM49_64_BITS   = SV_MACHINE_PARAMETER_934,
               SV_FORCE_ON_MEM65_80_BITS   = SV_MACHINE_PARAMETER_935,
               SV_FORCE_OFF_MEM1_16_BITS   = SV_MACHINE_PARAMETER_936,
               SV_FORCE_OFF_MEM17_32_BITS  = SV_MACHINE_PARAMETER_937,
               SV_FORCE_OFF_MEM33_48_BITS  = SV_MACHINE_PARAMETER_938,
               SV_FORCE_OFF_MEM49_64_BITS  = SV_MACHINE_PARAMETER_939,
               SV_FORCE_OFF_MEM65_80_BITS  = SV_MACHINE_PARAMETER_940	

IF True_M THEN BITTST P148Value_W 1 DisableKbInput_M,
               BITTST P170Value_W 0 AllowKbInput_M,
               BITTST P170Value_W 1 JogOverOnly_M,
               BITTST P170Value_W 2 KbOverOnly_M

IF DisableKbInput_M THEN RST AllowKbInput_M
IF JogOverOnly_M && KbOverOnly_M THEN RST KbOverOnly_M

;Enable Load Meters
IF SV_MACHINE_PARAMETER_57 != 0 THEN SET LoadMeterStage
IF SV_MACHINE_PARAMETER_57 == 0 THEN RST LoadMeterStage

;--Jog Key Orientation
IF True_M THEN JogKeyCfg_W = SV_MACHINE_PARAMETER_1
IF True_M THEN BITTST JogKeyCfg_W 1 InvertYJogKeys_M
IF True_M THEN BITTST JogKeyCfg_W 2 SwapAxes_M
IF True_M THEN BITTST JogKeyCfg_W 4 InvertXJogKeys_M

;Reset All Jog Direction Stages
IF True_M THEN RST JogKeysNormalStage,
               RST JogKeysInvert2Stage,
               RST JogKeysSwappedStage,
               RST JogKeysSwapAndInvert2Stage,
               RST JogKeysNormalXInvertStage,
               RST JogKeysInvert2XInvertStage,
               RST JogKeysSwappedXInvertStage,
               RST JogKeysSwapandInvert2XInvertStage

;Set Jog Direction Stage
IF !(InvertYJogKeys_M || SwapAxes_M  || InvertXJogKeys_M) THEN SET JogKeysNormalStage
IF InvertYJogKeys_M   && !SwapAxes_M && !InvertXJogKeys_M THEN SET JogKeysInvert2Stage
IF !InvertYJogKeys_M  && SwapAxes_M  && !InvertXJogKeys_M THEN SET JogKeysSwappedStage
IF InvertYJogKeys_M   && SwapAxes_M  && !InvertXJogKeys_M THEN SET JogKeysSwapAndInvert2Stage
IF !InvertYJogKeys_M  && !SwapAxes_M && InvertXJogKeys_M  THEN SET JogKeysNormalXInvertStage
IF  InvertYJogKeys_M  && !SwapAxes_M && InvertXJogKeys_M  THEN SET JogKeysInvert2XInvertStage
IF !InvertYJogKeys_M  &&  SwapAxes_M && InvertXJogKeys_M  THEN SET JogKeysSwappedXInvertStage
IF  InvertYJogKeys_M  &&  SwapAxes_M && InvertXJogKeys_M  THEN SET JogKeysSwapandInvert2XInvertStage

;Probe Protection
IF SV_MACHINE_PARAMETER_153 == 0 THEN  RST ProbeProtectionEnable_M
IF SV_MACHINE_PARAMETER_153 > 0 THEN  SET ProbeProtectionEnable_M

; Set (or reset) the jog panel flag 
IF SV_JOG_PANEL_REQUIRED THEN (JogPanelRequired_M)

;Enable Spindle Speed Scaling
IF True_M THEN PValue_W = SV_MACHINE_PARAMETER_78
IF True_M THEN BITTST PValue_W 4 SpindleScalingEnable_M

;Set Machine Type Based on Parameter 820
IF SV_MACHINE_PARAMETER_820 == 0 THEN (MachineIsMill_M)
IF SV_MACHINE_PARAMETER_820 == 1 THEN (MachineIsLathe_M)
IF SV_MACHINE_PARAMETER_820 == 2 THEN (MachineIsRouter_M)
IF SV_MACHINE_PARAMETER_820 == 3 THEN (MachineIsPlasma_M)
IF SV_MACHINE_PARAMETER_820 == 4 THEN (MachineIsLaser_M)

;ATC Timer Settings
IF SV_MACHINE_PARAMETER_961 > 0 THEN CarouselInOutTimer_T = SV_MACHINE_PARAMETER_961 * 1000
IF SV_MACHINE_PARAMETER_961 == 0 THEN CarouselInOutTimer_T = 3500
IF SV_MACHINE_PARAMETER_962 > 0 THEN OrientTimer_T = SV_MACHINE_PARAMETER_962 * 1000
IF SV_MACHINE_PARAMETER_962 == 0 THEN OrientTimer_T = 5000
IF SV_MACHINE_PARAMETER_963 > 0 THEN OrientLostTimer_T = SV_MACHINE_PARAMETER_963 
IF SV_MACHINE_PARAMETER_963 == 0 THEN OrientLostTimer_T = 200
IF SV_MACHINE_PARAMETER_964 > 0 THEN ToolClampUnclampTimer_T = SV_MACHINE_PARAMETER_964 * 1000
IF SV_MACHINE_PARAMETER_964 == 0 THEN ToolClampUnclampTimer_T = 2000

;AirPressureOk Delay
IF True_M THEN AirPressureLost_T = SV_MACHINE_PARAMETER_965

;SpindleFan
IF True_M THEN SpindleFan_T = SV_MACHINE_PARAMETER_997 * 1000

;=============================================================================
                        LubeUsePumpTimersStage
;=============================================================================

; METHOD 1 (SS == 0) For lube pumps with internal timers.
;
; When using this method, P179 should be set such that MMM is a
; value that is greater than the cycle time set on the internal timers and
; SS should be set to zero. How much greater MMM needs to be depends on the
; accuracy of the lube pump timers, but it is better to be on the long side
; to ensure proper operation.
;
; Example 1. The internal lube cycle interval is set to 60 minutes.
;            Set P179 = 7500. In this example, as long as the accuracy
;            of the lube timer interval causes the lube to turn on
;            within 75 minutes, it will work. Note that the amount of time
;            that lube is output is usually set with another timer control
;            on the lube pump and it does not factor into the setting of P179.
;
; It should be noted that lube pumps with internal timers may differ on how
; they operate.
;
; (a) For pumps that lube immediately when power is applied and then start timing
; until the next cycle, it is possible to run out of lube quickly on short job
; runs if, after the program has been run, lube power is removed.
;
; (b) For pumps that do not lube until it has been turned on for the interval time,
; it is possible that lube never gets applied if, after the short program has been run,
; lube power is removed.
;
; A short program or job run is defined as a job that finishes before
; the interval setting (60 minutes in the above example).
;
; For the above mentioned reasons, we want the power to be applied for at least
; the amount of time set by the inteval timer, noting that if the user decides
; to engage the E-stop to remove power after short jobs, then they risk the
; above mentioned problems accoding to the type of pump.
;
; On the start of SV_PROGRAM_RUNNING, the lube pump turns on.
; The lube pump is turned off when a program has NOT been
; running continuously for MMM minutes or E-stop is engaged.
; The reason the lube pump is turned off after a program has NOT been
; running for MMM minutes is to prevent lubing when the user leaves for the
; weekend, leaving the machine on and E-stop disengaged.

;IF SV_PROGRAM_RUNNING THEN SET Lube_O, RST LubeM_T
;IF !SV_PROGRAM_RUNNING THEN LubeM_T = LubeM_W, SET LubeM_T
;IF LubeM_T || SV_STOP THEN RST Lube_O

;=============================================================================
;                        LubeUsePLCTimersStage
;=============================================================================
;
; METHOD 2 (SS != 0) For lube pumps that do not have internal timers.
;
;  When using this method P179 should be set so the lube turns on
;  every MMM minutes for SS seconds.
;
;  Example 1.
;    To set the lube pump power to come on for 5 seconds
;    every 10 minutes, set P179 =  1005.
;                                 MMMSS
;  Example 2.
;    To set the lube pump power to come on for 30 seconds
;    every 2 hours, set P179 = 12030
;                              MMMSS
;
; This method will accumulate time while a program is running until
; it reaches MMM minutes, at which time it will apply power
; for SS seconds (unless E-stop is engaged) and then start over. It is
; possible with frequent use of E-stop that a lube cycle is cut short.
;

;IF SV_PROGRAM_RUNNING  THEN LubeM_T = LubeM_W, SET LubeM_T
;IF !SV_PROGRAM_RUNNING THEN (StopRunningPD_PD)
;IF StopRunningPD_PD THEN LubeAccumTime_W = LubeAccumTime_W + LubeM_T, RST LubeM_T
;IF LubeM_T || (LubeAccumTime_W + LubeM_T > LubeM_W)
;  THEN SET Lube_O, LubeS_T = LubeS_W, SET LubeS_T, RST LubeM_T, LubeAccumTime_W = 0
;IF LubeS_T || SV_STOP THEN RST Lube_O, RST LubeS_T

;=============================================================================
;                        KeyboardEventsStage
;=============================================================================
; This stage handles functions that are required for menu navigation
; by CNC11, require multiple keypresses and/or need to be interlocked
; with SV_PC_VIRTUAL_JOGPANEL_ACTIVE and/or AllowKbInput_M.  Regarding
; "AllowKbInput_M": This PLC program reads a bit from a system parameter,
; in this case bit 0 of SV_MACHINE_PARAMETER_170, and sets "AllowKbInput_M"
; if the bit is a "0".  If the operator wishes to allow keyboard input
; to trigger PLC events, they must set parameter 170 to a "1"
; (or any odd number for that matter).  It should be mentioned that
; the programmer will not want to interlock all keyboard keys with
; SV_PC_VIRTUAL_JOGPANEL_ACTIVE and/or AllowKbInput_M.  For example:
; The "escape" key must be echoed by the PLC to CNC11 to aid in menu
; navigation.  NOTE: For backward comaptibility with CNC10, setting bit 1
; of SV_MACHINE_PARAMETER_148 OR clearing bit 0 of SV_MACHINE_PARAMETER_170
; will disable keyboard jogging.

;To Make following logic easier to read, will combine L & R ctrl, shift, and
; alt keys. We should not only look for the key combination, but ensure other
; modifier keys are not pressed. Example, If Ctrl + Alt + F are pressed, the
; toggle for Fast/Slow jog should not activate, this key combination is used
; by menus in CNC12 and should not be acted on by the PLC unless that specific
; combination is required for the action.
;IF Kb_L_Shift_SV || Kb_R_Shift_SV THEN (KbShiftPressed_M)
;IF Kb_L_Ctrl_SV || Kb_R_Ctrl_SV THEN (KbCtrlPressed_M)
;IF Kb_L_Alt_SV || Kb_R_Alt_SV THEN (KbAltPressed_M)

;-------------------------Not interlocked------------------------
; The code for cycle cancel has been moved to the main stage.
; It is commented out below but remains for reference
;Cycle Cancel
;IF Kb_Escape THEN (KbCycleCancel_M)

;Rapidoverride: Ctrl-r
IF Kb_r_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M THEN (KbTogRapidOver_M)

;----------------Interlocked with AllowKbInput_M-------------------
;KbCycle Start: alt-s
IF Kb_s_SV && !KbShiftPressed_M && !KbCtrlPressed_M && KbAltPressed_M && AllowKbInput_M THEN (KbCycleStart_M)

;KbToolCheck_M: Ctrl-t
IF Kb_t_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbToolCheck_M)

;KbTogSingleBlock_M: ctrl-b
IF Kb_b_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbTogSingleBlock_M)

;KbTogSpinAutoMan_M: ctrl-a
IF Kb_a_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbTogSpinAutoMan_M)

;KbSpinCW_M: ctrl-c
IF Kb_c_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbSpinCW_M)

;KbSpinCCW_M: ctrl-w
IF Kb_w_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbSpinCCW_M)

;KbSpinStart_M:  ctrl-s
IF Kb_s_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbSpinStart_M)

;KbSpindle stop: Ctrl-q
IF Kb_q_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbSpinStop_M)

;KbIncSpinOver_M: ctrl (">")
IF Kb_Period_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbIncSpinOver_M)

;KbDecSpinOver_M: ctrl ("<")
IF Kb_Comma_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbDecSpinOver_M)

;KbSpinOver100_M: ctrl + /
IF Kb_Slash_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbSpinOver100_M)

;KbTogCoolAutoMan_M: Ctrl-m
IF Kb_m_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbTogCoolAutoMan_M)

;KbFloodOnOff_M: Ctrl-n
IF Kb_n_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbFloodOnOff_M)

;KbMistOnOff_M: Ctrl-k
IF Kb_k_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbMistOnOff_M)

;KbTogIncContJog_M: "ctrl" +  "i"
IF Kb_i_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbTogIncContJog_M)

;KbTogFastSlowJog_M: "ctrl" + "f"
IF Kb_f_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbTogFastSlowJog_M)

;KbAux1Key_M: "ctrl" + "F1"
IF Kb_F1_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbAux1Key_M)

;KbAux2Key_M: "ctrl" + "F2"
IF Kb_F2_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbAux2Key_M)

;KbAux3Key_M: "ctrl" + "F3"
IF Kb_F3_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbAux3Key_M)

;KbAux4Key_M: "ctrl" + "F4"
IF Kb_F4_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbAux4Key_M)

;KbAux5Key_M: "ctrl" + "F5"
IF Kb_F5_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbAux5Key_M)

;KbAux6Key_M: "ctrl" + "F6"
IF Kb_F6_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbAux6Key_M)

;KbAux7Key_M: "ctrl" + "F7"
IF Kb_F7_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbAux7Key_M)

;KbAux8Key_M: "ctrl" + "F8"
IF Kb_F8_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbAux8Key_M)

;KbAux9Key_M: "ctrl" + "F9"
IF Kb_F9_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbAux9Key_M)

;KbAux10Key_M: "ctrl" + "F10"
IF Kb_F10_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbAux10Key_M)

;KbAux11Key_M: "ctrl" + "F11"
IF Kb_F11_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbAux11Key_M)

;KbAux12Key_M: "ctrl" + "F12"
IF Kb_F12_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbAux12Key_M)

;KbAux13Key_M: "ctrl" + "1"
IF Kb_1_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbAux13Key_M)

;KbAux14Key_M: "ctrl" + "2"
IF Kb_2_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbAux14Key_M)

;KbAux15Key_M: "ctrl" + "3"
IF Kb_3_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbAux15Key_M)

;KbAux16Key_M: "ctrl" + "4"
IF Kb_4_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbAux16Key_M)

;KbIncFeedOver_M: "ctrl" + "keyboard +" (actually "=")
IF (Kb_Equals_SV || Kb_Num_Plus_SV) && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M
  THEN (KbIncFeedOver_M)

;KbDecFeedOver_M: "ctrl" + "keyboard -"
IF (Kb_Hyphen_SV || Kb_Num_Sub_SV) && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M
  THEN (KbDecFeedOver_M)

;KbFeedOver100_M: "ctrl" + "keyboard \"
IF Kb_Backslash_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M
  THEN (KbFeedOver100_M)

;--------Interlocked with AllowKbInput_M && KbJpActive_M-----------

;KbIncreaseJogInc_M: "insert"
IF Kb_Ins_SV && !KbShiftPressed_M && !KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M && KbJpActive_M
  THEN (KbIncreaseJogInc_M)
IF KbIncreaseJogInc_M && x1JogLED_O && !X1_M && !X10_M && !X100_M
  THEN SET X10_M
IF KbIncreaseJogInc_M && x10JogLED_O && !X1_M && !X10_M && !X100_M
  THEN SET X100_M

;KbDecreaseJogInc_M: "delete"
IF Kb_Del_SV && !KbShiftPressed_M && !KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M && KbJpActive_M
  THEN (KbDecreaseJogInc_M)
IF KbDecreaseJogInc_M && x10JogLED_O && !X1_M && !X10_M && !X100_M
  THEN SET X1_M
IF KbDecreaseJogInc_M && x100JogLED_O && !X1_M && !X10_M && !X100_M
  THEN SET X10_M

IF !KbIncreaseJogInc_M && !KbDecreaseJogInc_M THEN RST X1_M, RST X10_M,
  RST X100_M

;KbTogIncContJog_M: "ctrl" +  "i"
IF Kb_i_SV &&  (Kb_L_Ctrl_SV || Kb_R_Ctrl_SV) && AllowKbInput_M && KbJpActive_M
  THEN (KbTogIncContJog_M)

;KbTogFastSlowJog_M: "ctrl" + "f"
IF Kb_f_SV &&  (Kb_L_Ctrl_SV || Kb_R_Ctrl_SV) && AllowKbInput_M && KbJpActive_M
  THEN (KbTogFastSlowJog_M)

;KbJogAx1Plus_M: "ctrl" + "right arrow" or "numpad 6"
IF (Kb_Right_SV || Kb_Num_6_SV) && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M &&
  AllowKbInput_M && KbJpActive_M THEN (KbJogAx1Plus_M)

;KbJogAx1Minus_M: "ctrl" + "left arrow" or "numpad 4"
IF (Kb_Left_SV || Kb_Num_4_SV) && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M &&
  AllowKbInput_M && KbJpActive_M THEN (KbJogAx1Minus_M)

;KbJogAx2Plus_M: "ctrl" + "up arrow" or "numpad 8"
IF (Kb_Up_SV || Kb_Num_8_SV) && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M &&
  AllowKbInput_M && KbJpActive_M THEN (KbJogAx2Plus_M)

;KbJogAx1Minus_M: "ctrl" + "down arrow" or "numpad 2"
IF (Kb_Down_SV || Kb_Num_2_SV) && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M &&
  AllowKbInput_M && KbJpActive_M THEN (KbJogAx2Minus_M)

;KbJogAx3Plus_M: "ctrl" + "page up"
IF Kb_PgUp_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M && KbJpActive_M
  THEN (KbJogAx3Plus_M)

;KbJogAx3Minus_M: "ctrl" + "page down"
IF Kb_PgDown_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M && KbJpActive_M
  THEN (KbJogAx3Minus_M)

;KbAx4PlusJog: "ctrl" + "home"
IF Kb_Home_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M && KbJpActive_M
  THEN (KbJogAx4Plus_M)

;KbAx4MinusJog: "ctrl" + "end"
IF Kb_End_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M && KbJpActive_M
  THEN (KbJogAx4Minus_M)

;KbJogAx1MinusAx2Plus: "ctrl" + "numpad 7"
IF Kb_Num_7_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M && KbJpActive_M
  THEN (KbJogAx1MinusAx2Plus_M)

;KbJogAx1Ax2Plus: "ctrl" + "numpad 9"
IF Kb_Num_9_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M && KbJpActive_M
  THEN (KbJogAx1Ax2Plus_M)

;KbJogAx1Ax2Minus: "ctrl" + "numpad 1"
IF Kb_Num_1_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M && KbJpActive_M
  THEN (KbJogAx1Ax2Minus_M)

;KbJogAx1PlusAx2Minus: "ctrl" + "numpad 3"
IF Kb_Num_3_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M && KbJpActive_M
  THEN (KbJogAx1PlusAx2Minus_M)

IF True_M THEN RST KeyboardEventsStage

;=============================================================================
                           MPGStage
;=============================================================================
;                        MPG Functions

;Enable MPG Handwheel Jogging
IF MPG_AXIS_1_I || MPG_AXIS_2_I || MPG_AXIS_3_I || MPG_AXIS_4_I ||
  MPG_AXIS_5_I || MPG_AXIS_6_I || MPG_AXIS_7_I || MPG_AXIS_8_I
  THEN (MpgOn_M)

;HandWheel Axis Selection
;SV_MACHINE_PARAMETER_441-449 Determines Axis for MPG Encoder Inputs 1-9
IF HandWheel_M && !MPG_M THEN SV_MPG_1_AXIS_SELECT = SV_MACHINE_PARAMETER_441
IF HandWheel_M THEN SV_MPG_2_AXIS_SELECT = SV_MACHINE_PARAMETER_442
IF HandWheel_M THEN SV_MPG_3_AXIS_SELECT = SV_MACHINE_PARAMETER_443
IF HandWheel_M THEN SV_MPG_4_AXIS_SELECT = SV_MACHINE_PARAMETER_444
IF HandWheel_M THEN SV_MPG_5_AXIS_SELECT = SV_MACHINE_PARAMETER_445
IF HandWheel_M THEN SV_MPG_6_AXIS_SELECT = SV_MACHINE_PARAMETER_446
IF HandWheel_M THEN SV_MPG_7_AXIS_SELECT = SV_MACHINE_PARAMETER_447
IF HandWheel_M THEN SV_MPG_8_AXIS_SELECT = SV_MACHINE_PARAMETER_448
IF HandWheel_M THEN SV_MPG_9_AXIS_SELECT = SV_MACHINE_PARAMETER_449

; Enable the Software to read the Hardwired MPG with MPGLED
IF (MPGLED_O && HandWheel_M && !MPG_M) || MpgOn_M THEN (SV_MPG_1_ENABLED)
IF MPGLED_O && SV_MPG_2_AXIS_SELECT > 0 && !MpgOn_M THEN (SV_MPG_2_ENABLED)
IF MPGLED_O && SV_MPG_3_AXIS_SELECT > 0 && !MpgOn_M THEN (SV_MPG_3_ENABLED)
IF MPGLED_O && SV_MPG_4_AXIS_SELECT > 0 && !MpgOn_M THEN (SV_MPG_4_ENABLED)
IF MPGLED_O && SV_MPG_5_AXIS_SELECT > 0 && !MpgOn_M THEN (SV_MPG_5_ENABLED)
IF MPGLED_O && SV_MPG_6_AXIS_SELECT > 0 && !MpgOn_M THEN (SV_MPG_6_ENABLED)
IF MPGLED_O && SV_MPG_7_AXIS_SELECT > 0 && !MpgOn_M THEN (SV_MPG_7_ENABLED)
IF MPGLED_O && SV_MPG_8_AXIS_SELECT > 0 && !MpgOn_M THEN (SV_MPG_8_ENABLED)
IF MPGLED_O && SV_MPG_9_AXIS_SELECT > 0 && !MpgOn_M THEN (SV_MPG_9_ENABLED)

; Select axis to move
IF MPG_AXIS_1_I THEN SV_MPG_1_AXIS_SELECT = 1
IF MPG_AXIS_2_I THEN SV_MPG_1_AXIS_SELECT = 2
IF MPG_AXIS_3_I THEN SV_MPG_1_AXIS_SELECT = 3
IF MPG_AXIS_4_I THEN SV_MPG_1_AXIS_SELECT = 4
IF MPG_AXIS_5_I THEN SV_MPG_1_AXIS_SELECT = 5
IF MPG_AXIS_6_I THEN SV_MPG_1_AXIS_SELECT = 6
IF MPG_AXIS_7_I THEN SV_MPG_1_AXIS_SELECT = 7
IF MPG_AXIS_8_I THEN SV_MPG_1_AXIS_SELECT = 8

;Select Multiplier
IF x100JogLED_O THEN SV_MPG_1_MULTIPLIER = 100, SV_MPG_2_MULTIPLIER = 100, SV_MPG_3_MULTIPLIER = 100,
                     SV_MPG_4_MULTIPLIER = 100, SV_MPG_5_MULTIPLIER = 100, SV_MPG_6_MULTIPLIER = 100,
                     SV_MPG_7_MULTIPLIER = 100, SV_MPG_8_MULTIPLIER = 100, SV_MPG_9_MULTIPLIER = 100
IF x10JogLED_O THEN SV_MPG_1_MULTIPLIER = 10, SV_MPG_2_MULTIPLIER = 10, SV_MPG_3_MULTIPLIER = 10,
                    SV_MPG_4_MULTIPLIER = 10, SV_MPG_5_MULTIPLIER = 10, SV_MPG_6_MULTIPLIER = 10,
                    SV_MPG_7_MULTIPLIER = 10, SV_MPG_8_MULTIPLIER = 10, SV_MPG_9_MULTIPLIER = 10
IF x1JogLED_O THEN SV_MPG_1_MULTIPLIER = 1, SV_MPG_2_MULTIPLIER = 1, SV_MPG_3_MULTIPLIER = 1,
                   SV_MPG_4_MULTIPLIER = 1, SV_MPG_5_MULTIPLIER = 1, SV_MPG_6_MULTIPLIER = 1,
                   SV_MPG_7_MULTIPLIER = 1, SV_MPG_8_MULTIPLIER = 1, SV_MPG_9_MULTIPLIER = 1

; Disable "Windup" mode IF x10 or x100 selected
IF (SV_MPG_1_MULTIPLIER < 10) THEN (SV_MPG_1_WINDUP_MODE)
IF (SV_MPG_2_MULTIPLIER < 10) THEN (SV_MPG_2_WINDUP_MODE)
IF (SV_MPG_3_MULTIPLIER < 10) THEN (SV_MPG_3_WINDUP_MODE)
IF (SV_MPG_4_MULTIPLIER < 10) THEN (SV_MPG_4_WINDUP_MODE)
IF (SV_MPG_5_MULTIPLIER < 10) THEN (SV_MPG_5_WINDUP_MODE)
IF (SV_MPG_6_MULTIPLIER < 10) THEN (SV_MPG_6_WINDUP_MODE)
IF (SV_MPG_7_MULTIPLIER < 10) THEN (SV_MPG_7_WINDUP_MODE)
IF (SV_MPG_8_MULTIPLIER < 10) THEN (SV_MPG_8_WINDUP_MODE)
IF (SV_MPG_9_MULTIPLIER < 10) THEN (SV_MPG_9_WINDUP_MODE)

;=============================================================================
                           WirelessMpgStage
;=============================================================================
;                        MPG Functions
;Determine Active Axes 1-8
IF True_M THEN UsbMpgActiveAxes_W = SV_MACHINE_PARAMETER_218
IF True_M THEN WTB UsbMpgActiveAxes_W UsbMpgAxis1Active_M 8

;Read Axis Select Knob
; Check to see if Knob changed since last scan for later logic.
IF UsbAxisMonitor_W != SV_USB_MPG_AXIS_SELECT THEN (UsbAxisKnobChanged_M)
IF True_M THEN UsbAxisMonitor_W = SV_USB_MPG_AXIS_SELECT

;Read Scale Selector Knob
IF True_M THEN UsbScaleMonitor_W = SV_USB_MPG_SCALE_SELECT 

  ;Use echoed word value for usb mpg axis select so it can be explicitly set to 0 for invalid axes. 
IF (SV_USB_MPG_SCALE_SELECT > 100) || 
  ((UsbAxisMonitor_W == 1) && !UsbMpgAxis1Active_M) ||
  ((UsbAxisMonitor_W == 2) && !UsbMpgAxis2Active_M) ||
  ((UsbAxisMonitor_W == 3) && !UsbMpgAxis3Active_M) ||
  ((UsbAxisMonitor_W == 4) && !UsbMpgAxis4Active_M)
  THEN SV_MPG_1_AXIS_SELECT = 0, UsbAxisMonitor_W = 0 

;Enable USB MPG Handwheel Jogging
IF SV_USB_MPG_POWER && ((UsbAxisMonitor_W > 0) && UsbScaleMonitor_W <= 100) THEN (UsbMpgOn_M)
  
;Select axis to move
IF (SV_USB_MPG_SCALE_SELECT <= 100) && ((UsbAxisMonitor_W == 1) && UsbMpgAxis1Active_M)
  THEN SV_MPG_1_AXIS_SELECT = 1

IF (SV_USB_MPG_SCALE_SELECT <= 100) && ((UsbAxisMonitor_W == 2) && UsbMpgAxis2Active_M)
  THEN SV_MPG_1_AXIS_SELECT = 2

IF (SV_USB_MPG_SCALE_SELECT <= 100) && ((UsbAxisMonitor_W == 3) && UsbMpgAxis3Active_M)
  THEN SV_MPG_1_AXIS_SELECT = 3  

IF (SV_USB_MPG_SCALE_SELECT <= 100) && ((UsbAxisMonitor_W == 4) && UsbMpgAxis4Active_M)
  THEN SV_MPG_1_AXIS_SELECT = 4

IF (SV_USB_MPG_SCALE_SELECT <= 100) && ((UsbAxisMonitor_W == 5) && UsbMpgAxis5Active_M)
  THEN SV_MPG_1_AXIS_SELECT = 5
  
IF (SV_USB_MPG_SCALE_SELECT <= 100) && ((UsbAxisMonitor_W == 6) && UsbMpgAxis6Active_M)
  THEN SV_MPG_1_AXIS_SELECT = 6
  
IF (SV_USB_MPG_SCALE_SELECT <= 100) && ((UsbAxisMonitor_W == 7) && UsbMpgAxis7Active_M)
  THEN SV_MPG_1_AXIS_SELECT = 7
  
IF (SV_USB_MPG_SCALE_SELECT <= 100) && ((UsbAxisMonitor_W == 8) && UsbMpgAxis8Active_M)
  THEN SV_MPG_1_AXIS_SELECT = 8

IF UsbAxisMonitor_W == 0 THEN SV_MPG_1_AXIS_SELECT = 0

;HandWheel Axis Selection
;SV_MACHINE_PARAMETER_441-449 Determines Axis for MPG Encoder Inputs 1-9
IF HandWheel_M && !MPG_M THEN SV_MPG_1_AXIS_SELECT = SV_MACHINE_PARAMETER_441
IF HandWheel_M THEN SV_MPG_2_AXIS_SELECT = SV_MACHINE_PARAMETER_442
IF HandWheel_M THEN SV_MPG_3_AXIS_SELECT = SV_MACHINE_PARAMETER_443
IF HandWheel_M THEN SV_MPG_4_AXIS_SELECT = SV_MACHINE_PARAMETER_444
IF HandWheel_M THEN SV_MPG_5_AXIS_SELECT = SV_MACHINE_PARAMETER_445
IF HandWheel_M THEN SV_MPG_6_AXIS_SELECT = SV_MACHINE_PARAMETER_446
IF HandWheel_M THEN SV_MPG_7_AXIS_SELECT = SV_MACHINE_PARAMETER_447
IF HandWheel_M THEN SV_MPG_8_AXIS_SELECT = SV_MACHINE_PARAMETER_448
IF HandWheel_M THEN SV_MPG_9_AXIS_SELECT = SV_MACHINE_PARAMETER_449

; Enable the Software to read the Wireless MPG or Hardwired MPGs with MPGLED
IF (MPGLED_O && HandWheel_M && !MPG_M) || UsbMpgOn_M THEN (SV_MPG_1_ENABLED)
IF MPGLED_O && SV_MPG_2_AXIS_SELECT > 0 && !UsbMpgOn_M THEN (SV_MPG_2_ENABLED)
IF MPGLED_O && SV_MPG_3_AXIS_SELECT > 0 && !UsbMpgOn_M THEN (SV_MPG_3_ENABLED)
IF MPGLED_O && SV_MPG_4_AXIS_SELECT > 0 && !UsbMpgOn_M THEN (SV_MPG_4_ENABLED)
IF MPGLED_O && SV_MPG_5_AXIS_SELECT > 0 && !UsbMpgOn_M THEN (SV_MPG_5_ENABLED)
IF MPGLED_O && SV_MPG_6_AXIS_SELECT > 0 && !UsbMpgOn_M THEN (SV_MPG_6_ENABLED)
IF MPGLED_O && SV_MPG_7_AXIS_SELECT > 0 && !UsbMpgOn_M THEN (SV_MPG_7_ENABLED)
IF MPGLED_O && SV_MPG_8_AXIS_SELECT > 0 && !UsbMpgOn_M THEN (SV_MPG_8_ENABLED)
IF MPGLED_O && SV_MPG_9_AXIS_SELECT > 0 && !UsbMpgOn_M THEN (SV_MPG_9_ENABLED)

;Select Multiplier
IF x100JogLED_O THEN SV_MPG_1_MULTIPLIER = 100, SV_MPG_2_MULTIPLIER = 100, SV_MPG_3_MULTIPLIER = 100,
                     SV_MPG_4_MULTIPLIER = 100, SV_MPG_5_MULTIPLIER = 100, SV_MPG_6_MULTIPLIER = 100,
                     SV_MPG_7_MULTIPLIER = 100, SV_MPG_8_MULTIPLIER = 100, SV_MPG_9_MULTIPLIER = 100
IF x10JogLED_O THEN SV_MPG_1_MULTIPLIER = 10, SV_MPG_2_MULTIPLIER = 10, SV_MPG_3_MULTIPLIER = 10,
                    SV_MPG_4_MULTIPLIER = 10, SV_MPG_5_MULTIPLIER = 10, SV_MPG_6_MULTIPLIER = 10,
                    SV_MPG_7_MULTIPLIER = 10, SV_MPG_8_MULTIPLIER = 10, SV_MPG_9_MULTIPLIER = 10
IF x1JogLED_O THEN SV_MPG_1_MULTIPLIER = 1, SV_MPG_2_MULTIPLIER = 1, SV_MPG_3_MULTIPLIER = 1,
                   SV_MPG_4_MULTIPLIER = 1, SV_MPG_5_MULTIPLIER = 1, SV_MPG_6_MULTIPLIER = 1,
                   SV_MPG_7_MULTIPLIER = 1, SV_MPG_8_MULTIPLIER = 1, SV_MPG_9_MULTIPLIER = 1

;Disable "Windup" mode IF anything above x1 selected
IF (SV_MPG_1_MULTIPLIER < 10) THEN (SV_MPG_1_WINDUP_MODE)
IF (SV_MPG_2_MULTIPLIER < 10) THEN (SV_MPG_2_WINDUP_MODE)
IF (SV_MPG_3_MULTIPLIER < 10) THEN (SV_MPG_3_WINDUP_MODE)
IF (SV_MPG_4_MULTIPLIER < 10) THEN (SV_MPG_4_WINDUP_MODE)
IF (SV_MPG_5_MULTIPLIER < 10) THEN (SV_MPG_5_WINDUP_MODE)
IF (SV_MPG_6_MULTIPLIER < 10) THEN (SV_MPG_6_WINDUP_MODE)
IF (SV_MPG_7_MULTIPLIER < 10) THEN (SV_MPG_7_WINDUP_MODE)
IF (SV_MPG_8_MULTIPLIER < 10) THEN (SV_MPG_8_WINDUP_MODE)
IF (SV_MPG_9_MULTIPLIER < 10) THEN (SV_MPG_9_WINDUP_MODE)

;Set Data to be seen by set axis Macro 0
IF ((SV_USB_MPG_AXIS_SELECT == 1) && UsbMpgAxis1Active_M) THEN (UsbMpgAxis1Selected_M)
IF ((SV_USB_MPG_AXIS_SELECT == 2) && UsbMpgAxis2Active_M) THEN (UsbMpgAxis2Selected_M)
IF ((SV_USB_MPG_AXIS_SELECT == 3) && UsbMpgAxis3Active_M) THEN (UsbMpgAxis3Selected_M)
IF ((SV_USB_MPG_AXIS_SELECT == 4) && UsbMpgAxis4Active_M) THEN (UsbMpgAxis4Selected_M)
IF ((SV_USB_MPG_AXIS_SELECT == 5) && UsbMpgAxis5Active_M) THEN (UsbMpgAxis5Selected_M)
IF ((SV_USB_MPG_AXIS_SELECT == 6) && UsbMpgAxis6Active_M) THEN (UsbMpgAxis6Selected_M)
IF ((SV_USB_MPG_AXIS_SELECT == 7) && UsbMpgAxis7Active_M) THEN (UsbMpgAxis7Selected_M)
IF ((SV_USB_MPG_AXIS_SELECT == 8) && UsbMpgAxis8Active_M) THEN (UsbMpgAxis8Selected_M)

;Handle WMPG Wheel Delta
; UsbWheelDelta is used throughout PLC, we handle the calculation here.
IF True_M THEN UsbWheelCurrent_W = SV_USB_MPG_ENCODER_WHEEL
IF True_M THEN UsbWheelDelta_W = (UsbWheelCurrent_W - UsbWheelLast_W)
IF True_M THEN UsbWheelLast_W = UsbWheelCurrent_W

;Set Bit for Wheel Moving.
; Depending on wheel speed, delta may be 0 for some passes of the PLC.
; So we hold the Bit on for set time before turning bit off.
IF True_M THEN SET UsbMpgWheelStopped_T
IF UsbWheelDelta_W != 0 THEN RST UsbMpgWheelStopped_T
IF !UsbMpgWheelStopped_T THEN (UsbMpgWheelMoving_M)

;==============================================================================
                          CheckExternalUSBPanelStage
;==============================================================================
;Set Memory Bit to remember that panel was online.
IF ExtUsbPanel1Online_M THEN SET ExtUsbPanel1CheckFault_M
IF ExtUsbPanel2Online_M THEN SET ExtUsbPanel2CheckFault_M
IF ExtUsbPanel3Online_M THEN SET ExtUsbPanel3CheckFault_M
IF ExtUsbPanel4Online_M THEN SET ExtUsbPanel4CheckFault_M

;Check Panels for Faults
IF !SoftwareNotReady_M && ExtUsbPanel1CheckFault_M && !ExtUsbPanel1Online_M
  THEN FaultMsg_W = EXT_USB_PANEL_1_FLT_C
IF !SoftwareNotReady_M && ExtUsbPanel2CheckFault_M && !ExtUsbPanel2Online_M
  THEN FaultMsg_W = EXT_USB_PANEL_2_FLT_C
IF !SoftwareNotReady_M && ExtUsbPanel3CheckFault_M && !ExtUsbPanel3Online_M
  THEN FaultMsg_W = EXT_USB_PANEL_3_FLT_C
IF !SoftwareNotReady_M && ExtUsbPanel4CheckFault_M && !ExtUsbPanel4Online_M
  THEN FaultMsg_W = EXT_USB_PANEL_4_FLT_C

;=============================================================================
                           JogPanelStage
;=============================================================================
;--MPG Key
IF MPGKey_I || SkinMPG_M_SV THEN (MpgPD_PD)
IF MpgPD_PD && MPGLED_O THEN SET MPGManOffFlag_M
IF (!SV_MPG_1_ENABLED && MPG_M) || (MpgPD_PD && !MPGLED_O) ||
   (UsbAxisKnobChanged_M && MPGManOffFlag_M) THEN RST MPGManOffFlag_M

;MPG LED On/Off
IF MPG_M && !SV_MPG_1_ENABLED THEN (MPGOff_PD)
IF ((MpgPD_PD ^ MPGLED_O) || (SV_MPG_1_ENABLED && !MPGManOffFlag_M && MPG_M)) &&
  !MPGOff_PD THEN (MPGLED_O), (MPG_LED_OUT_O)

;Lockout X100 Z-Axis if Selected by MPG
IF MpgX100LockOut_M && MPGLED_O &&
  ((SV_MPG_1_AXIS_SELECT == 3 && !MachineIsLathe_M) ||
  (SV_MPG_1_AXIS_SELECT == 1 && MachineIsLathe_M))
  THEN (MpgZAxisLocked_M)

;--Select x1, x10, or x100 
;-X1
IF x1JogKey_I || SkinX1_M_SV || X1_M THEN (x1JogPD_PD)
IF x1JogPD_PD || OnAtPowerUp_M || (MPG_Inc_X_1_I && MPGLED_O && MpgOn_M) ||
  (UsbMpgOn_M && MPGLED_O && (UsbScaleMonitor_W == 1))
  THEN SET x1JogLED_O, RST x10JogLED_O, RST x100JogLED_O

;-X10
IF x10JogKey_I || SkinX10_M_SV || X10_M THEN (x10JogPD_PD)
IF x10JogPD_PD || (MPG_Inc_X_10_I && MPGLED_O && MpgOn_M)  ||
  (MPG_Inc_X_100_I && MPGLED_O && MpgZAxisLocked_M) ||
  (UsbMpgOn_M && MPGLED_O && ((UsbScaleMonitor_W == 10) ||
  ((UsbScaleMonitor_W == 100) && MpgZAxisLocked_M)))
  THEN RST x1JogLED_O, SET x10JogLED_O, RST x100JogLED_O

;-X100
IF x100JogKey_I || SkinX100_M_SV || X100_M THEN (x100JogPD_PD)
IF x100JogPD_PD || ((MPG_Inc_X_100_I && MPGLED_O && MpgOn_M)  || 
  (UsbMpgOn_M && MPGLED_O && (UsbScaleMonitor_W == 100))) &&
  !MpgZAxisLocked_M
  THEN RST x1JogLED_O, RST x10JogLED_O, SET x100JogLED_O

;--Select Incremental or Continuous Jog Mode
IF IncrContKey_I || KbTogIncContJog_M || SkinIncCont_M_SV THEN (IncrContPD_PD)
IF (IncrContPD_PD && !IncrContLED_O) || OnAtPowerUp_M || x1JogPD_PD || x10JogPD_PD || x100JogPD_PD ||
  (UsbMpgOn_M && MPGLED_O && UsbScaleMonitor_W == 1) THEN SET IncrContLED_O
IF (IncrContPD_PD && IncrContLED_O) || (UsbMpgOn_M && MPGLED_O &&
  (UsbScaleMonitor_W == 10 || UsbScaleMonitor_W == 100)) THEN RST IncrContLED_O

;--Select Fast or Slow Jog Mode
IF FastSlowKey_I || KbTogFastSlowJog_M || SkinFastSlowJog_M_SV THEN (SlowFastPD_PD)
IF (SlowFastPD_PD && !FastSlowLED_O) || OnAtPowerUp_M ||
  (UsbMpgOn_M && MPGLED_O && (UsbScaleMonitor_W == 1 || UsbScaleMonitor_W == 10 ||
  (UsbScaleMonitor_W == 100 && MpgZAxisLocked_M))) THEN SET FastSlowLED_O
IF (SlowFastPD_PD && FastSlowLED_O) || (UsbMpgOn_M && MPGLED_O && !MpgZAxisLocked_M &&
  UsbScaleMonitor_W == 100) THEN RST FastSlowLED_O

;--Single Block Mode

IF SingleBlockKey_I || KbTogSingleBlock_M || SkinSingleBlock_M_SV THEN (SingleBlockPD_PD)
IF SingleBlockPD_PD && !SingleBlockLED_O && !SV_PROGRAM_RUNNING
  THEN SET SingleBlockLED_O
IF SingleBlockPD_PD && SingleBlockLED_O THEN RST SingleBlockLED_O
IF SingleBlockLED_O THEN (SelectSingleBlock_SV)

;--Toolcheck
IF (ToolCheckKey_I || KbToolCheck_M || MpgToolCheck_M || SkinToolCheck_M_SV) && EStopOk_M THEN (ToolCheckPD_PD)

IF ToolCheckPD_PD THEN (DoToolCheck_SV)

;--Feed Hold Mode
; Note: the feedrate override values used here for testing against P146
; are those calculated in the previous scan.  There is no problem with that.
IF (FeedHoldKey_I || KbFeedHold_M || MpgFeedHold_M || SkinFeedHold_M_SV) THEN (FeedHoldPD_PD)

IF FeedHoldPD_PD || ActivateFeedHold_M ||
   (FinalFeedOverride_W < P146Value_W && !OnAtPowerUp_M)
  THEN SET FeedHoldLED_O
IF !SV_PROGRAM_RUNNING || DoCycleStart_SV || DoCycleCancel_SV || DoToolCheck_SV || 
   (FinalFeedOverride_W >= P146Value_W &&
    PrevFeedOverride_W < P146Value_W)
  THEN RST FeedHoldLED_O
IF True_M THEN PrevFeedOverride_W = FinalFeedOverride_W
; (FeedHoldLED will be used later to signal MPU11 to do Feed Hold)

;--Feedrate Override Section

;------------------------------------------------------------------------------
;--Feedrate Override Section
;------------------------------------------------------------------------------
; Feedrate override works as follows:
;
; 1. The PLC reads the 8 bit value of the FeedrateKnob_W directly (0-255)
; 2. The PLC scales this value to a 0-200 value (0-200%) by dividing by
;    the knob value by 127.5 and then multiplying the result by 100
; 3. If keyboard jogging is enabled, the PLC
;    determines whether the operator is using the keyboard override or
;    the FeedrateKnob_W to override the feedrate by watching which was changed
;    most recently.  The most recently changed value is saved as
;    "FinalFeedOverride_W"
; 4. Parameter 39 in (From the "params" screen in CNC11 software) stores
;    a value which the PLC program must use to limit the amount
;    of override applied to the programmed feedrate. This value is specified
;    as a percentage.
; 5. The PLC limits the override percentage by reading parameter 39 and, if
;    the feedrate override percentage as read from the knob is greater than
;    parameter 39, it sets the FinalFeedOverride_W value to the value of
;    parameter 39.
; 6. Once the override percentage has been determined and limited (if needed)
;    The PLC send this value up to the CNC11 software by setting
;    SV_PLC_FEEDRATE_KNOB = FinalFeedOverride_W
; 7. CNC11 reads SV_PLC_FEEDRATE_KNOB, factors in its own override based
;    on parameter 78 (see operators manual for more info on parm 78) and then
;    returns an override value to the PLC in the system variable
;    SV_PC_FEEDRATE_PERCENTAGE
; 8. The PLC reads SV_PC_FEEDRATE_PERCENTAGE and (typically) echoes the system
;    variable to SV_PLC_FEEDRATE_OVERRIDE which the MPU11 uses as the final
;    determination of the feedrate override percentage.
;------------------------------------------------------------------------------
; 1. The PLC reads the 8 bit value of the FeedrateKnob_W directly (0-255)
; NOTE: BTW = Bit To Word
; BTW reads the specified number of bits (if none is specified it defaults to 8)
; starting from a bit location and writes them to a word with the starting bit
; location being written to the LSB of the word used.  Below, BTW reads the bit
; values from JpFeedOrKnobBit0 to JpFeedOrKnobBit7 and writes them into to the
; word "FeedrateKnob_W" which sets FeedrateKnob_W to a value of 0-255
;------------------------------------------------------------------------------
IF True_M THEN FeedrateKnob_W = 1,
             BTW FeedrateKnob_W JpFeedOrKnobBit0_I 8

;------------------------------------------------------------------------------
; 2. Scale this value to a 0-200 value (0-200%)
;------------------------------------------------------------------------------
IF True_M THEN FeedrateKnob_W = (FeedrateKnob_W/127.5)*100
IF FeedrateKnob_W <= 1 THEN FeedrateKnob_W = 1

IF FeedrateKnob_W > SV_MACHINE_PARAMETER_39
  THEN FeedrateKnob_W = SV_MACHINE_PARAMETER_39
;------------------------------------------------------------------------------
; 3.  Determine whether to use FeedrateKnob_W or KbOverride_W
;------------------------------------------------------------------------------
; This section determines when to use the feedrate override value sent down
; by the jog panel (FeedrateKnob_W) or the feedrate override as determined
; by the PLC monitoring the keyboard override keys (KbOverride_W).
;------------------------------------------------------------------------------
;     At powerup, default feedrate override is jog panel (FeedrateKnob_W)
;       To use both keyboard or jog panel overrides set p170 to 0 (default)
;       To use jog panel override only set p170 to 2
;       To use keyboard only set p170 to 4
;-----------------------------------------------------------------------------
IF OnAtPowerUp_M && KbOverOnly_M THEN KbOverride_W = 100
IF OnAtPowerUp_M && !KbOverOnly_M THEN SET UsingFeedrateKnob_M,
                                       KbOverride_W = FeedrateKnob_W,
                                       Last_FeedrateKnob_W = FeedrateKnob_W

;----------------Calculate keyboard and VCP feedrate override-----------------
; SleepTimer is used to limit the KbOverride_W update rate
;-----------------------------------------------------------------------------
IF True_M THEN SkinFeedOverTimer_T = 200
IF SkinFeedOverMinus_M_SV THEN (SkinFeedOverMinusPD_PD), SET SkinFeedOverTimer_T
IF SkinFeedOverPlus_M_SV THEN (SkinFeedOverPlusPD_PD), SET SkinFeedOverTimer_T
IF !SkinFeedOverPlus_M_SV && !SkinFeedOverMinus_M_SV THEN RST SkinFeedOverTimer_T 

IF !WaitingForSleepTimer_M && ((KbIncFeedOver_M || SkinFeedOverPlusPD_PD) || 
   (SkinFeedOverTimer_T && SkinFeedOverPlus_M_SV))  
  THEN KbOverride_W = KbOverride_W + 1,
       RST UsingFeedrateKnob_M,
       SET WaitingForSleepTimer_M,
       SleepTimer_T = 30, SET SleepTimer_T

IF !WaitingForSleepTimer_M && ((KbDecFeedOver_M || SkinFeedOverMinusPD_PD) || 
   (SkinFeedOverTimer_T && SkinFeedOverMinus_M_SV))
  THEN KbOverride_W = KbOverride_W - 1,
       RST UsingFeedrateKnob_M,
       SET WaitingForSleepTimer_M,
	   SleepTimer_T = 30, SET SleepTimer_T

;MPG Feedrate Override Logic
IF !UsbMpgFeedWheelSelect_M || UsingFeedrateKnob_M THEN RST UsbMpgFeedWheelSet_M
IF (UsbMpgFeedWheelSelect_M && !UsbMpgFeedWheelSet_M) 
  THEN SET UsbMpgFeedWheelSet_M, RST UsingFeedrateKnob_M
IF UsbMpgFeedWheelSelect_M && !MpgSetAxisZero_M && (UsbWheelDelta_W != 0) THEN RST UsingFeedrateKnob_M
IF UsbMpgFeedWheelSet_M && !MpgSetAxisZero_M THEN KbOverride_W = (KbOverride_W + UsbWheelDelta_W)

;Ext Usb Feedrate Override Logic
;Divide Knob by 4 as every "tick" is 4 counts.

;Initialize LastKnob Value to Current on Startup. Prevents a "jump" in value
; from occurring on startup if the knob value reported by External panel is not 0.
IF !Initialize_T THEN ExtUsbLastFeedKnob_W = ExtUsbFeedKnob_W / 4
IF Initialize_T THEN ExtUsbFeedDelta_W = ((ExtUsbFeedKnob_W / 4) - ExtUsbLastFeedKnob_W)
IF Initialize_T && (ExtUsbFeedDelta_W != 0) THEN RST UsingFeedrateKnob_M
IF Initialize_T THEN ExtUsbLastFeedKnob_W = ExtUsbFeedKnob_W / 4

;Check if Software is Ready and if Panel is Online.
; If Software is not ready, then assume panel is still connected but
; 	software was restarted. In this case, we set Delta to 0 until software
;   comes back online.
; If Software is ready and panel is not online, then assume board was unplugged
;	and lost power, we need to set delta to 0 and also set Last Feed Knob to 0.
IF SoftwareNotReady_M && !ExtUsbPanel1Online_M THEN ExtUsbFeedDelta_W = 0
IF !SoftwareNotReady_M && !ExtUsbPanel1Online_M THEN ExtUsbFeedDelta_W = 0,
                                                     ExtUsbLastFeedKnob_W = 0

IF True_M THEN KbOverride_W = (KbOverride_W + ExtUsbFeedDelta_W)

;Feedrate % VCP Buttons
IF SkinFeedOver100_SV || KbFeedOver100_M THEN KbOverride_W = 100, RST UsingFeedrateKnob_M
IF SkinFeedOver75_SV THEN KbOverride_W = 75, RST UsingFeedrateKnob_M
IF SkinFeedOver50_SV THEN KbOverride_W = 50, RST UsingFeedrateKnob_M
IF SkinFeedOver25_SV THEN KbOverride_W = 25, RST UsingFeedrateKnob_M

;------------Switch to FeedrateKnob_W if it changes more than 3%--------------
; Once it has changed by more than 3%, it will update as normal (1% increments)
; until it sees another KbOverride_W command at which point it will take
; another 3% change to re-activate the FeedrateKnob_W

IF (ABS(Last_FeedrateKnob_W - FeedrateKnob_W) >= 3) || UsingFeedrateKnob_M
  THEN FinalFeedOverride_W = FeedrateKnob_W, KbOverride_W = FeedrateKnob_W,
       Last_FeedrateKnob_W = FeedrateKnob_W, SET UsingFeedrateKnob_M

;Limit keyboard override to parm 39.  Allowing the FeedrateKnob_W to go past
;parm 39, but keeping the KbOverride_W limited keeps the "dead space"
;down and allows the PLC to respond to changes in the FeedrateKnob_W even if
;above 120. Overall override is still limited later but this gives better
;response in changing between KbOverride_W & the FeedrateKnob_W
IF KbOverride_W > SV_MACHINE_PARAMETER_39
  THEN KbOverride_W = SV_MACHINE_PARAMETER_39
  
IF KbOverride_W < MIN_FROR_PCT_C THEN KbOverride_W = MIN_FROR_PCT_C

IF !UsingFeedrateKnob_M && !JogOverOnly_M
  THEN FinalFeedOverride_W = KbOverride_W

IF OnAtPowerUp_M THEN FinalFeedOverride_W = 100, KbOverride_W = 100
  
;------------------------------------------------------------------------------
; 4 & 5. Limit override percentage to value set in Parameter 39
;------------------------------------------------------------------------------
;------------------Limit final override percentage to parm 39------------------
IF FinalFeedOverride_W > SV_MACHINE_PARAMETER_39
  THEN FinalFeedOverride_W = SV_MACHINE_PARAMETER_39

IF FinalFeedOverride_W <= 1 THEN FinalFeedOverride_W = 1

;------------------------------------------------------------------------------
;  Override Controls
;  It is important that the PLC program only writes to SV_PLC_FEEDRATE_KNOB once per pass
;------------------------------------------------------------------------------
; Override control bit for the feedrate override
; 1 == feedrate override knob will effect feedrate
; 0 == override knob has NO effect on feedrate
IF  !SV_PC_OVERRIDE_CONTROL_FEEDRATE_OVERRIDE THEN FinalFeedOverride_W = 100

;------------------------------------------------------------------------------
; 6. Send override percentage to CNC12
;------------------------------------------------------------------------------
;----------------Send override to PC for modification if needed----------------
IF True_M THEN SV_PLC_FEEDRATE_KNOB = FinalFeedOverride_W

;Activate LED's
IF FinalFeedOverride_W == 100 THEN (FeedOver100LED_O)
IF FinalFeedOverride_W == 75 THEN (FeedOver75LED_O)
IF FinalFeedOverride_W == 50 THEN (FeedOver50LED_O)
IF FinalFeedOverride_W == 25 THEN (FeedOver25LED_O)

;------------------------------------------------------------------------------
; 7. Copy the feedrate override sent from the PC to the MPU11.
;------------------------------------------------------------------------------
;------------------------------------------------------------------------------
; Normally a number from 0.0-2.0, no limitations although V will not exceed
; Vmax. A negative number in here would be extremely bad.
;------------------------------------------------------------------------------
IF True_M THEN SV_PLC_FEEDRATE_OVERRIDE = SV_PC_FEEDRATE_PERCENTAGE/100.0

;--Rapidrate Override Section
;Rapid Override Button
IF KbTogRapidOver_M || SV_PC_TOGGLE_RAPID_OVERRIDE || SkinRapidOver_SV
  THEN (RapidOverPD_PD), RST SV_PC_TOGGLE_RAPID_OVERRIDE
IF (RapidOverPD_PD ^ SelectRapidOverride_SV) || OnAtPowerUp_M THEN (SelectRapidOverride_SV)

IF RapidOverPD_PD THEN OverrideMsgTimer_T = 100, SET OverrideMsgTimer_T

IF SelectRapidOverride_SV THEN (RapidOverLED_O), (OverrideRapidsEnabled_M)
IF !SelectRapidOverride_SV THEN (OverrideRapidsDisabled_M)

IF RapidOverPD_PD && OverrideRapidsEnabled_M THEN InfoMsg_W = RAPID_OVERRIDE_ENABLED_C
IF RapidOverPD_PD && OverrideRapidsDisabled_M THEN InfoMsg_W = RAPID_OVERRIDE_DISABLED_C

IF ((InfoMsg_W == RAPID_OVERRIDE_ENABLED_C) || (InfoMsg_W == RAPID_OVERRIDE_DISABLED_C)) && 
  OverrideMsgTimer_T THEN InfoMsg_W = 0, RST OverrideMsgTimer_T, RST ShowInfoStage
  
;FeedRapid Link Button
IF SkinFeedRapidLink_M || SV_PC_TOGGLE_RAPID_FEED_LINK
  THEN (FeedRapid_PD), RST SV_PC_TOGGLE_RAPID_FEED_LINK
IF FeedRapid_PD && UsingFeedrateKnob_M THEN RST UsingFeedrateKnob_M
IF ((FeedRapid_PD ^ SelectRapidLink) || (OnAtPowerUp_M || UsingFeedrateKnob_M)) && UsingLinkedFeature_M
  THEN (SelectRapidLink)
  
IF SelectRapidLink THEN (FeedRapidLinkLED)

;Rapid Rate Override % Buttons
IF SkinRapidOver100_M THEN RapidRateOverride_W = 100, RST UsingFeedrateKnob_M
IF SkinRapidOver75_M THEN RapidRateOverride_W = 75, RST UsingFeedrateKnob_M
IF SkinRapidOver50_M THEN RapidRateOverride_W = 50, RST UsingFeedrateKnob_M
IF SkinRapidOver25_M THEN RapidRateOverride_W = 25, RST UsingFeedrateKnob_M

;Set Rapid Override Initial Value
IF OnAtPowerUp_M THEN RapidRateOverride_W = 100

;VCP Plus/Minus Buttons
IF True_M THEN SkinRapidOverTimer_T = 200
IF SkinRapidOverMinus_M THEN (SkinRapidOverMinusPD), SET SkinRapidOverTimer_T
IF SkinRapidOverPlus_M THEN (SkinRapidOverPlusPD), SET SkinRapidOverTimer_T
IF !SkinRapidOverPlus_M && !SkinRapidOverMinus_M THEN RST SkinRapidOverTimer_T

IF !WaitingForSleepTimer_M && ((SkinRapidOverPlusPD) || (SkinRapidOverTimer_T && SkinRapidOverPlus_M))
  THEN RapidRateOverride_W = RapidRateOverride_W + 1,
       RST UsingFeedrateKnob_M,
       SET WaitingForSleepTimer_M,
       SleepTimer_T = 30, SET SleepTimer_T

IF !WaitingForSleepTimer_M && ((SkinRapidOverMinusPD) || (SkinRapidOverTimer_T && SkinRapidOverMinus_M))
  THEN RapidRateOverride_W = RapidRateOverride_W - 1,
		RST UsingFeedrateKnob_M,
		SET WaitingForSleepTimer_M,
		SleepTimer_T = 30, SET SleepTimer_T

IF SleepTimer_T THEN RST WaitingForSleepTimer_M, RST SleepTimer_T

;MPG Rapid Override Logic
IF UsbMpgFeedWheelSelect_M && MpgSetAxisZero_M && (UsbWheelDelta_W != 0) THEN RST UsingFeedrateKnob_M

;Ext Usb Rapid Rate Override Logic
;Divide Knob by 4 as every "tick" is 4 counts.
;Initialize LastKnob Value to Current on Startup. Prevents a "jump" in value
; from occurring on startup if the knob value reported by External panel is not 0.
IF !Initialize_T THEN ExtUsbLastRapidKnob_W = ExtUsbRapidKnob_W / 4
IF Initialize_T THEN ExtUsbRapidDelta_W = ((ExtUsbRapidKnob_W / 4) - ExtUsbLastRapidKnob_W)
IF Initialize_T && (ExtUsbRapidDelta_W != 0) THEN RST UsingFeedrateKnob_M
IF Initialize_T THEN ExtUsbLastRapidKnob_W = ExtUsbRapidKnob_W / 4

;Check if Panel is Online, if not then we set Delta to 0, this prevents
; "jumps" to RapidRate value in the case panel is disconnected/reconnected.
IF SoftwareNotReady_M && !ExtUsbPanel1Online_M THEN ExtUsbRapidDelta_W = 0

;Check if Software is Ready and if Panel is Online.
; If Software is not ready, then assume panel is still connected but
; 	software was restarted. In this case, we set Delta to 0 until software
;   comes back online.
; If Software is ready and panel is not online, then assume board was unplugged
;	and lost power, we need to set delta to 0 and also set Last Rapid Knob to 0.
IF SoftwareNotReady_M && !ExtUsbPanel1Online_M THEN ExtUsbRapidDelta_W = 0
IF !SoftwareNotReady_M && !ExtUsbPanel1Online_M THEN ExtUsbRapidDelta_W = 0,
                                                     ExtUsbLastRapidKnob_W = 0

;Add the delta to RapidRateOverride_W
IF SelectRapidOverride_SV && Initialize_T
  THEN RapidRateOverride_W = (RapidRateOverride_W + ExtUsbRapidDelta_W)

;MPG add delta to RapidRateOverride_W
IF UsbMpgFeedWheelSelect_M && MpgSetAxisZero_M
  THEN RapidRateOverride_W = (RapidRateOverride_W + UsbWheelDelta_W)
  
;When UsingPhysical Knob, Set RapidRateOverride_W to FinalFeedOverride_W
IF UsingFeedrateKnob_M THEN RapidRateOverride_W = FeedrateKnob_W

;Bound RapidRateOverride_W between 1-100%
IF RapidRateOverride_W > 100 THEN RapidRateOverride_W = 100
IF RapidRateOverride_W < 1 THEN RapidRateOverride_W = 1
  
;When Rapid Override is Not Selected, PC side controls Rate, PLC word has no effect.
; We set it to 100% in this case for graphical clarification.
IF True_M THEN FinalRapidRateOverride_W = RapidRateOverride_W
IF !SelectRapidOverride_SV THEN FinalRapidRateOverride_W = 100

;Send Percentage to CNC12
; Send Final Rapid Rate Override % to CNC12
; If FeedRapidLink or UsingFeedrateKnob_M (Pot Style Knob found on Physical
;  Centroid Control Panels) then set SV_PLC_RAPID_FEEDRATE_OVERRIDE to 0 for
;  "Old" Functionality.
; In this case, we set FinalRapidRateOverride_W to FinalFeedOverride_W for
;  graphical purposes.
IF RapidRateOverrideEnabled_M THEN SV_PLC_RAPID_FEEDRATE_OVERRIDE = FinalRapidRateOverride_W * 0.01
IF FeedRapidLinkLED || UsingFeedrateKnob_M || !RapidRateOverrideEnabled_M
  THEN SV_PLC_RAPID_FEEDRATE_OVERRIDE = 0

;We need to link Feed and Rapid depending on what currently is being adjusted.
;Adjust both based on Feed Rate
IF RapidRateOverrideEnabled_M && FeedRapidLinkLED && Initialize_T &&
  (FinalFeedOverride_W != LastFinalFeedOverride_W)
  THEN FinalRapidRateOverride_W = FinalFeedOverride_W,
       RapidRateOverride_W = FinalFeedOverride_W
IF True_M THEN LastFinalFeedOverride_W = FinalFeedOverride_W

;Adjust both based on Rapid Rate
IF RapidRateOverrideEnabled_M && FeedRapidLinkLED && Initialize_T &&
  (FinalRapidRateOverride_W != LastFinalRapidOverride_W)
  THEN FinalFeedOverride_W = FinalRapidRateOverride_W,
       KbOverride_W = FinalRapidRateOverride_W
IF True_M THEN LastFinalRapidOverride_W = FinalRapidRateOverride_W

;Activate LED's
IF FinalRapidRateOverride_W == 100 THEN (RapidOver100LED)
IF FinalRapidRateOverride_W == 75 THEN (RapidOver75LED)
IF FinalRapidRateOverride_W == 50 THEN (RapidOver50LED)
IF FinalRapidRateOverride_W == 25 THEN (RapidOver25LED)

;--MPU11 Jog Panel Key Functions
IF (CycleCancelKey_I || KbCycleCancel_M || MpgResetKey_M || SkinCycleCancel_M_SV) && (SV_PROGRAM_RUNNING || SV_MDI_MODE)
   || ErrorFlag_M
  THEN (DoCycleCancel_SV)
IF (CycleStartKey_I || KbCycleStart_M || MpgCycleStart_M || SkinCycleStart_M_SV) THEN (DoCycleStart_SV)
;IF CycleCancelKey  THEN (DoEscapeKey) ; uncomment if CANCEL should exit menus

; First and second axis jogging is in configuration-specific
; stages following JogPanelStage
;Axis 3
IF (Ax3PlusJogKey_I  || KbJogAx3Plus_M || UsbMpgAxis3JogPlus_M || SkinJogAx3Plus_SV) &&
  !(IncrContLED_O && FinalFeedOverride_W == 0) THEN (DoAx3PlusJog_SV)
IF (Ax3MinusJogKey_I || KbJogAx3Minus_M || UsbMpgAxis3JogMinus_M || SkinJogAx3Minus_SV) &&
  !Ax3MinusJogDisabled_M && !(IncrContLED_O && FinalFeedOverride_W == 0) THEN (DoAx3MinusJog_SV)

;Axis 4
IF (Ax4PlusJogKey_I  || KbJogAx4Plus_M || UsbMpgAxis4JogPlus_M || SkinJogAx4Plus_SV) &&
  !Ax4PlusJogDisabled_M && !(IncrContLED_O && FinalFeedOverride_W == 0) THEN (DoAx4PlusJog_SV)
IF (Ax4MinusJogKey_I || KbJogAx4Minus_M || UsbMpgAxis4JogMinus_M || SkinJogAx4Minus_SV) &&
  !Ax4MinusJogDisabled_M && !(IncrContLED_O && FinalFeedOverride_W == 0) THEN (DoAx4MinusJog_SV)

;Axis 5
IF (SkinJogAx5Plus_SV || UsbMpgAxis5JogPlus_M) && !Ax5PlusJogDisabled_M &&
  !(IncrContLED_O && FinalFeedOverride_W == 0) THEN (DoAx5PlusJog_SV)
IF (SkinJogAx5Minus_SV || UsbMpgAxis5JogMinus_M) && !Ax5MinusJogDisabled_M &&
  !(IncrContLED_O && FinalFeedOverride_W == 0) THEN (DoAx5MinusJog_SV)

;Axis 6
IF (SkinJogAx6Plus_SV || UsbMpgAxis6JogPlus_M) && !Ax6PlusJogDisabled_M &&
  !(IncrContLED_O && FinalFeedOverride_W == 0) THEN (DoAx6PlusJog_SV)
IF (SkinJogAx6Minus_SV || UsbMpgAxis6JogMinus_M) && !Ax6MinusJogDisabled_M &&
  !(IncrContLED_O && FinalFeedOverride_W == 0) THEN (DoAx6MinusJog_SV)

;Axis 7
IF (SkinJogAx7Plus_SV || UsbMpgAxis7JogPlus_M) && !Ax7PlusJogDisabled_M &&
    !(IncrContLED_O && FinalFeedOverride_W == 0) THEN (DoAx7PlusJog_SV)
If (SkinJogAx7Minus_SV || UsbMpgAxis7JogMinus_M) && !Ax7MinusJogDisabled_M &&
    !(IncrContLED_O && FinalFeedOverride_W == 0) THEN (DoAx7MinusJog_SV)

;Axis 8
IF (SkinJogAx8Plus_SV || UsbMpgAxis8JogPlus_M) && !Ax8PlusJogDisabled_M &&
    !(IncrContLED_O && FinalFeedOverride_W == 0) THEN (DoAx8PlusJog_SV)
IF (SkinJogAx8Minus_SV || UsbMpgAxis8JogMinus_M) && !Ax8MinusJogDisabled_M &&
    !(IncrContLED_O && FinalFeedOverride_W == 0) THEN (DoAx8MinusJog_SV)

IF (Aux1Key_I || KbAux1Key_M || SkinAux1_M_SV) THEN (DoAux1Key_SV)
IF (Aux2Key_I || KbAux2Key_M || SkinAux2_M_SV) THEN (DoAux2Key_SV)
IF (Aux3Key_I || KbAux3Key_M || SkinAux3_M_SV) THEN (DoAux3Key_SV)
IF (Aux4Key_I || KbAux4Key_M || SkinAux4_M_SV) THEN (DoAux4Key_SV)
IF (Aux5Key_I || KbAux5Key_M || SkinAux5_M_SV) THEN (DoAux5Key_SV)
IF (Aux6Key_I || KbAux6Key_M || SkinAux6_M_SV) THEN (DoAux6Key_SV)
IF (Aux7Key_I || KbAux7Key_M || SkinAux7_M_SV) THEN (DoAux7Key_SV)
IF (Aux8Key_I || KbAux8Key_M || SkinAux8_M_SV || M51_SV) THEN (DoAux8Key_SV)
IF (Aux9Key_I || KbAux9Key_M || SkinAux9_M_SV || M50_SV) THEN (DoAux9Key_SV)
IF (Aux10Key_I || KbAux10Key_M || SkinAux10_M_SV) THEN (DoAux10Key_SV)
IF (Aux11Key_I || KbAux11Key_M || SkinAux11_M_SV) THEN (DoAux11Key_SV)
IF (Aux12Key_I || KbAux12Key_M || SkinAux12_M_SV) THEN (DoAux12Key_SV)
IF (Aux13Key_I || KbAux13Key_M || SkinAux13_SV) THEN (DoAux13Key_SV)
IF (Aux14Key_I || KbAux14Key_M || SkinAux14_SV) THEN (DoAux14Key_SV)
IF (Aux15Key_I || KbAux15Key_M || SkinAux15_SV) THEN (DoAux15Key_SV)
IF (Aux16Key_I || KbAux16Key_M || SkinAux16_SV) THEN (DoAux16Key_SV)
IF x1JogLED_O    THEN (SelectX1JogInc_SV)
IF x10JogLED_O   THEN (SelectX10JogInc_SV)
IF x100JogLED_O  THEN (SelectX100JogInc_SV)
IF IncrContLED_O THEN (SelectIncContJog_SV)
IF FastSlowLED_O THEN (SelectFastSlowJog_SV)
IF MPGLED_O      THEN (SelectMpgMode_SV)
IF FeedHoldLED_O && SV_PC_OVERRIDE_CONTROL_FEEDHOLD THEN (DoFeedHold_SV)


;--Coolant Functions
;--Toggle auto coolant mode
IF CoolAutoManKey_I || KbTogCoolAutoMan_M || SkinCoolAutoMan_M_SV THEN (CoolantAutoManualPD_PD)

IF (!CoolAutoModeLED_O && CoolantAutoManualPD_PD) || OnAtPowerUp_M
  THEN SET CoolAutoModeLED_O

IF (CoolAutoModeLED_O && CoolantAutoManualPD_PD)
  THEN RST CoolAutoModeLED_O

;--Report coolant mode to CNC11
IF CoolAutoModeLED_O THEN (SelectCoolAutoMan_SV)

;--Display coolant mode message
;changing to auto coolant mode ;2050 Auto Coolant Selected 2 + 50*256
IF (!CoolAutoModeLED_O && CoolantAutoManualPD_PD && AllowKbInput_M)
  THEN InfoMsg_W = AUTO_COOL_MSG_C

;changing to manual coolant mode ;2051 Manual Coolant Selected 2 + 51*256
IF (CoolAutoModeLED_O && CoolantAutoManualPD_PD && AllowKbInput_M)
  THEN InfoMsg_W = MAN_COOL_MSG_C

;--Flood coolant on/off
; In auto mode:
;  Turn on if M8
;  Turn off if fault, toolcheck, or not M8
; In manual mode:
;  Turn off if entering manual mode
;  Toggle by key press
;IF CoolFloodKey_I || KbFloodOnOff_M || SkinCoolFlood_M_SV THEN (CoolantFloodPD_PD)
;IF ((Flood_O ^ (!CoolAutoModeLED_O && CoolantFloodPD_PD)) ||
;   CoolAutoModeLED_O && M8_SV) &&
;   !(SV_STOP || CoolantAutoManualPD_PD || CoolAutoModeLED_O && !M8_SV || ErrorFlag_M || DoToolCheck_SV)
;  THEN (Flood_O), (CoolFloodLED_O), (SelectCoolantFlood_SV)
;
;--Mist coolant on/off
;IF (CoolMistKey_I || KbMistOnOff_M || SkinCoolMist_M_SV) THEN (CoolantMistPD_PD)
;IF ((Mist_O ^ (!CoolAutoModeLED_O && CoolantMistPD_PD)) ||
;   CoolAutoModeLED_O && M7_SV) &&
;   !(SV_STOP || CoolantAutoManualPD_PD || CoolAutoModeLED_O && !M7_SV || ErrorFlag_M || DoToolCheck_SV)
;  THEN (Mist_O), (CoolMistLED_O), (SelectCoolantMist_SV)
;
;--Spindle Control
;-------------------------------------------------------------
; JOGBOARD SPINDLE CONTROL
; Spindle Auto Mode / Manual mode toggles via Auto/Man jog panel key
; CW/CCW jog keys determine spindle direction in manual mode
; M3/M4 system variables determine spindle direction in Auto mode
; Spindle can be stopped and restarted in auto mode using
; spin stop/start jog keys
;-------------------------------------------------------------
;--Select Auto or Manual Spindle Operation Mode
;Triggers to Toggle Auto/Manual Spindle Mode
IF SpinAutoManKey_I || KbTogSpinAutoMan_M || SkinSpinAutoMan_M_SV || UsbMpgSpinAutoMan_M
  THEN (SpinAutoManPD_PD)

;--Set spindle to auto mode on startup
IF (SpinAutoManPD_PD && !SpinAutoModeLED_O) || OnAtPowerUp_M
  THEN SET SpinAutoModeLED_O

;--Set spindle to manual mode
IF SpinAutoManPD_PD && SpinAutoModeLED_O THEN RST SpinAutoModeLED_O

;--Report the Spindle mode to CNC11
IF SpinAutoModeLED_O THEN (SelectManAutoSpindle_SV)

;--Set triggers to start and stop the spindle

; Check for tripped limits, which force a spindle stop per CE requirements.
IF SV_LIMIT_TRIPPED THEN (LimitTripped_M)

; NOTE: SpindlePause_M allows the operator to start and stop the
; spindle with the spin start and stop keys while in a job.  In
; this case, pressing the spindle start key will only restart
; the spindle if an M3 or M4 had previously been issued and is
; still active.
;Handling for MPG Spindle on/off button MpgSpinOnOff_M
IF UsbMpgSpinOnOff_M && !UsbMpgSpinOnOffPressed_M && !UsbMpgSpinOnState_M
	THEN SET UsbMpgSpinOnState_M, SET UsbMpgSpinOn_M, SET UsbMpgSpinOnOffPressed_M, RST UsbMpgSpinOff_M

IF UsbMpgSpinOnOff_M && !UsbMpgSpinOnOffPressed_M && UsbMpgSpinOnState_M
	THEN SET UsbMpgSpinOff_M, RST UsbMpgSpinOn_M, SET UsbMpgSpinOnOffPressed_M, RST UsbMpgSpinOnState_M  
	
IF !UsbMpgSpinOnOff_M
	THEN RST UsbMpgSpinOnOffPressed_M, RST UsbMpgSpinOn_M, RST UsbMpgSpinOff_M

IF (SpinAutoModeLED_O && (M3_SV || M4_SV) && (SpinStopKey_I || KbSpinStop_M || UsbMpgSpinOff_M || SkinSpinStop_M_SV))
  THEN SET SpindlePause_M
  
IF ((M3_SV || M4_SV) && (SpinStartKey_I || KbSpinStart_M || UsbMpgSpinOn_M || SkinSpinStart_M_SV) ||
    !(SV_PROGRAM_RUNNING || SV_MDI_MODE))
  THEN RST SpindlePause_M

;Handle Spindle Start
IF ((SpinStartKey_I || KbSpinStart_M || UsbMpgSpinOn_M || SkinSpinStart_M_SV) && !SpinAutoModeLED_O) ||
  (SpinAutoModeLED_O && (M3_SV || M4_SV) && !SpindlePause_M) ||
  ((SpinStartKey_I || KbSpinStart_M || UsbMpgSpinOn_M) && ((M3_SV || M4_SV) && SpinAutoModeLED_O))
  THEN (SpinStart_M)

;Handle Spindle Stop
IF (SpinStopKey_I || KbSpinStop_M || UsbMpgSpinOff_M || SkinSpinStop_M_SV) ||
   (SpinAutoModeLED_O && !(M3_SV || M4_SV)) ||
   (SV_PC_RIGID_TAP_SPINDLE_OFF && SpinAutoModeLED_O) ||
   ProbeDetect_I || SV_STOP || ErrorFlag_M || SV_LIMIT_TRIPPED
  THEN (SpinStop_M)

;--Adjust spindle override when entering manual or auto spin mode
;Set the override value to 100% when spin auto mode is first selected
IF SpinAutoManPD_PD && !SpinAutoModeLED_O
  THEN SV_PLC_SPINDLE_KNOB = 100,
       SET SpinAutoModeLED_O

;Set the override value to 10% whenever manual mode is entered
IF SpinAutoManPD_PD && SpinAutoModeLED_O
  THEN SV_PLC_SPINDLE_KNOB = 10, RST SpinAutoModeLED_O

;--Set spindle direction
;------------------Set Clockwise direction
IF ((KbSpinCW_M || SpinCWKey_I || SkinSpinCW_M_SV) && !SpinAutoModeLED_O) || (M3_SV && SpinAutoModeLED_O)
  THEN RST SpindleDirection_M
IF !SpindleDirection_M THEN (SpindleCWLED_O), (SelectSpindleCW_SV)

;---------------Set Counterclockwise direction
IF ((KbSpinCCW_M || SpinCCWKey_I || SkinSpinCCW_M_SV) && !SpinAutoModeLED_O) || (M4_SV && SpinAutoModeLED_O)
  THEN SET SpindleDirection_M
IF SpindleDirection_M THEN (SpindleCCWLED_O), (SelectSpindleCCW_SV)

IF SpindleDirection_M ^ SpinRangeReversed_M THEN (SpindleDirectionOut_O)

;-------------------------------------------------------------------------------
;                                Turn spindle on/off
;-------------------------------------------------------------------------------
IF ProbeDetect_I && SpinStart_M THEN SET ProbeFault_M

IF (SpindleEnableOut_O || SpinStart_M ) && !SpinStop_M
  THEN (SpindleEnableOut_O)

IF !SpindleEnableOut_O THEN (DoSpindleStop_SV)

;-------------------------------------------------------
;          SPINDLE OVERRIDE CONTROL
;       Jogboard (-, +, and 100% keys),
; Keyboard "ctrl" + "<", "ctrl" + ">", "ctrl" + "/"
;-------------------------------------------------------
IF SpinOverPlusKey_I || KbIncSpinOver_M || SkinSpinOverPlus_M_SV
  THEN SV_PLC_SPINDLE_KNOB = SV_PLC_SPINDLE_KNOB + 1
IF SpinOverMinusKey_I || KbDecSpinOver_M || SkinSpinOverMinus_M_SV
  THEN SV_PLC_SPINDLE_KNOB = SV_PLC_SPINDLE_KNOB - 1
IF SpinOver100Key_I || KbSpinOver100_M || OnAtPowerUp_M || SkinSpin100_M_SV
  THEN SV_PLC_SPINDLE_KNOB = 100
  
;MPG Spindle Logic
IF !UsbMpgSpinWheelSelect_M THEN RST UsbMpgSpinWheelSet_M
IF (UsbMpgSpinWheelSelect_M && !UsbMpgSpinWheelSet_M) THEN SET UsbMpgSpinWheelSet_M
IF UsbMpgSpinWheelSet_M THEN SV_PLC_SPINDLE_KNOB = (SV_PLC_SPINDLE_KNOB + UsbWheelDelta_W)

;Ext Usb Spindle Override Logic
;Divide Knob by 4 as every "tick" is 4 counts.
;Initialize LastKnob Value to Current on Startup. Prevents a "jump" in value
; from occurring on startup if the knob value reported by External panel is not 0.
IF !Initialize_T THEN ExtUsbLastSpinKnob_W = ExtUsbSpinKnob_W / 4
IF Initialize_T THEN ExtUsbSpinDelta_W = ((ExtUsbSpinKnob_W / 4) - ExtUsbLastSpinKnob_W)
IF Initialize_T THEN ExtUsbLastSpinKnob_W = ExtUsbSpinKnob_W / 4

;Check if Panel is Online, if not then we set Delta to 0, this prevents
; "jumps" to Feedrate value in the case panel is disconnected/reconnected.
IF SoftwareNotReady_M && !ExtUsbPanel1Online_M THEN ExtUsbSpinDelta_W = 0

;Check if Software is Ready and if Panel is Online.
; If Software is not ready, then assume panel is still connected but
; 	software was restarted. In this case, we set Delta to 0 until software
;   comes back online.
; If Software is ready and panel is not online, then assume board was unplugged
;	and lost power, we need to set delta to 0 and also set Last Spin Knob to 0.
IF SoftwareNotReady_M && !ExtUsbPanel1Online_M THEN ExtUsbSpinDelta_W = 0
IF !SoftwareNotReady_M && !ExtUsbPanel1Online_M THEN ExtUsbSpinDelta_W = 0,
                                                     ExtUsbLastSpinKnob_W = 0

IF True_M THEN SV_PLC_SPINDLE_KNOB = (SV_PLC_SPINDLE_KNOB + ExtUsbSpinDelta_W)

IF SV_PLC_SPINDLE_KNOB < 1  THEN SV_PLC_SPINDLE_KNOB = 1
IF SV_PLC_SPINDLE_KNOB > 200 THEN SV_PLC_SPINDLE_KNOB = 200

IF SV_PLC_SPINDLE_KNOB == 100 THEN
  (SpinOver100LED_O),
  (SelectSpinOR100_SV)

IF SV_PLC_SPINDLE_KNOB < 100 THEN
  (SpinOverMinusLED_O),
  (DoDecreaseSpindleOR_SV )

IF SV_PLC_SPINDLE_KNOB > 100 THEN
  (SpinOverPlusLED_O),
  (DoIncreaseSpindleOR_SV)

;--Output 12-bit DAC value for spindle control
;-----------------------------------------------------------------------------
;             Read spindle range inputs and/or range M codes
;
; NOTE: SV_SPINDLE_LOW_RANGE & SV_SPINDLE_MID_RANGE M are used to report the
; selected spindle range to CNC11
;-----------------------------------------------------------------------------
;   4 hi   3 med-high  2 med-low  1 low
;    0          1         1         0   SV_SPINDLE_MID_RANGE M
;    0          0         1         1   SV_SPINDLE_LOW_RANGE

; Use input switches, M functions, or other means to determine the gear
; range number (1-4).  For basic mills, look for one low-range switch.
; Default to high range until proven otherwise (fail-safe choice)
IF True_M THEN SpindleRange_W = 4
IF (SpinLowRange_I) THEN SpindleRange_W = 1

; Use the gear range number to set the range flags and speed ratio.

IF SpindleRange_W == 1 THEN SET SV_SPINDLE_LOW_RANGE,
                            RST SV_SPINDLE_MID_RANGE,
                            SpinRangeAdjust_FW = SV_MACHINE_PARAMETER_65

IF SpindleRange_W == 2 THEN SET SV_SPINDLE_LOW_RANGE,
                            SET SV_SPINDLE_MID_RANGE,
                            SpinRangeAdjust_FW = SV_MACHINE_PARAMETER_66

IF SpindleRange_W == 3 THEN RST SV_SPINDLE_LOW_RANGE,
                            SET SV_SPINDLE_MID_RANGE,
                            SpinRangeAdjust_FW = SV_MACHINE_PARAMETER_67

IF SpindleRange_W == 4 THEN RST SV_SPINDLE_LOW_RANGE,
                            RST SV_SPINDLE_MID_RANGE,
                            SpinRangeAdjust_FW = 1.0

; If the speed ratio parameter is negative, reverse the motor.
; Always use the absolute value of the parameter as the real ratio.
IF SpinRangeAdjust_FW < 0.0 THEN (SpinRangeReversed_M),
                                 SpinRangeAdjust_FW = -SpinRangeAdjust_FW

; Force the ratio to be non-zero, because we are going to divide by it later.
IF SpinRangeAdjust_FW < 0.001 THEN SpinRangeAdjust_FW = 0.001

;----------------------------------------------------------------
;              Read commanded spindle speed, max & min
;
; ***NOTE***  SV_PC_COMMANDED_SPINDLE_SPEED already has override
;             factored in.
;----------------------------------------------------------------
IF True_M THEN CfgMinSpeed_FW = SV_PC_CONFIG_MIN_SPINDLE_SPEED,
             CfgMaxSpeed_FW = SV_PC_CONFIG_MAX_SPINDLE_SPEED
; Calculate #RPM's per bit of resolution
IF CfgMaxSpeed_FW > 0.0 THEN RPMPerBit_FW = CfgMaxSpeed_FW/65535.0
IF CfgMaxSpeed_FW <= 0.0 THEN RPMPerBit_FW = 1.0

IF SpinAutoModeLED_O THEN SpinSpeedCommand_FW = SV_PC_COMMANDED_SPINDLE_SPEED
IF !SpinAutoModeLED_O THEN SpinSpeedCommand_FW = CfgMaxSpeed_FW *
                                               SV_PLC_SPINDLE_KNOB / 200.0 *
                                               SpinRangeAdjust_FW
IF !SpindleEnableOut_O THEN SpinSpeedCommand_FW = 0.0

;----------------------------------------------------------------
; If commanded spindle speed is < Min Spin Speed * SpinRangeAdjust
; & commanded spindle speed > 0, force to commanded spindle speed
; = min spin speed value * SpinRangeAdjust.
;----------------------------------------------------------------
IF (SpinSpeedCommand_FW > 0.0) &&
   (SpinSpeedCommand_FW < (CfgMinSpeed_FW * SpinRangeAdjust_FW))
  THEN SpinSpeedCommand_FW = (CfgMinSpeed_FW * SpinRangeAdjust_FW),
       InfoMsg_W = MIN_SPEED_MSG_C

;---------------------------------------------------------------------------
; If SpinSpeedCommand_FW > Max Spin Speed * SpinRangeAdjust, force
; SpinSpeedCommand_FW = max spin speed value * SpinRangeAdjust.
;---------------------------------------------------------------------------
IF SpinSpeedCommand_FW > (CfgMaxSpeed_FW * SpinRangeAdjust_FW)
  THEN SpinSpeedCommand_FW = (CfgMaxSpeed_FW * SpinRangeAdjust_FW)

; The following bits control the actual analog hardware output on the OAK.
; Output = 16bit (0-65536) Default 0-10VDC.
; Different analog ranges are available by setting Outputs 15 and 16:
; ----------------------------------------
; | Output 15 | Output 16 | Range         |
; |     0     |     0     | 0 to +10VDC   |
; |     0     |     1     | 0 to +5VDC    |
; |     1     |     0     | -5 to +5VDC   |
; |     1     |     1     | -10 to +10VDC | 
; -----------------------------------------

IF (!SpindleDACModeBit1_O && !SpindleDACModeBit2_O) ||
  (!SpindleDACModeBit1_O && SpindleDACModeBit2_O)
  THEN SET ZeroTo5Or10Stage, RST Minus5Or10ToPlus5Or10Stage
  
IF (SpindleDACModeBit1_O && !SpindleDACModeBit2_O) ||
  (SpindleDACModeBit1_O && SpindleDACModeBit2_O)
  THEN RST ZeroTo5Or10Stage, SET Minus5Or10ToPlus5Or10Stage

;------------------------------------------------------------------------------
                             ZeroTo5Or10Stage
;------------------------------------------------------------------------------
;----------------------------------------------------------------
; Convert Spindle "S" command to 16 bit value for output to DAC
;----------------------------------------------------------------
; Commanded Spindle speed (includes override factor) is sent down from CNC11
; in SV_PC_COMMANDED_SPINDLE_SPEED.  This value needs to be converted to a
; 16 bit value (0-65535) where full scale = SV_PC_CONFIG_MAX_SPINDLE_SPEED.

;Display calculated RPM value on PC
IF True_M THEN SV_PLC_SPINDLE_SPEED = SpinSpeedCommand_FW

;Scale Spindle Speed if Enabled
; This allows 0V to be the minimum Spindle Speed.
IF SpindleScalingEnable_M && SpinSpeedCommand_FW > 0.0 && CfgMaxSpeed_FW > 0.0
  THEN SpinSpeedCommand_FW = (((SpinSpeedCommand_FW - CfgMinSpeed_FW) /
                             (CfgMaxSpeed_FW - CfgMinSpeed_FW)) * CfgMaxSpeed_FW)

;Convert RPM to 16 bit value
IF True_M THEN SixteenBitSpeed_FW = SpinSpeedCommand_FW/RPMPerBit_FW

; Factor in gear range
IF True_M THEN SixteenBitSpeed_FW = (SixteenBitSpeed_FW/SpinRangeAdjust_FW)

;Convert to integer word for DAC & I/O display
IF True_M THEN SixteenBitSpeed_W = SixteenBitSpeed_FW

; Bound min to 0, max to 65535
IF SixteenBitSpeed_W < 0 THEN SixteenBitSpeed_W = 0
IF SixteenBitSpeed_W > 65535 THEN SixteenBitSpeed_W = 65535

; Output to DAC
IF True_M THEN WTB SixteenBitSpeed_W SpinAnalogOutBit0_O 16

;------------------------------------------------------------------------------
                       Minus5Or10ToPlus5Or10Stage
;------------------------------------------------------------------------------
;----------------------------------------------------------------
; Convert Spindle "S" command to 16 bit value for output to DAC
;----------------------------------------------------------------
; Commanded Spindle speed (includes override factor) is sent down from CNC11
; in SV_PC_COMMANDED_SPINDLE_SPEED.  This value needs to be converted to a
; 16 bit value (0-65535) where full scale = SV_PC_CONFIG_MAX_SPINDLE_SPEED.
; 0 = -10VDC, 32768 = 0VDC, 65536 = +10VDC

;Display calculated RPM value on PC
IF True_M THEN SV_PLC_SPINDLE_SPEED = SpinSpeedCommand_FW  

;Scale Spindle Speed if Enabled
; This allows 0V to be the minimum Spindle Speed.
IF SpindleScalingEnable_M && SpinSpeedCommand_FW > 0.0 && CfgMaxSpeed_FW > 0.0
  THEN SpinSpeedCommand_FW = (((SpinSpeedCommand_FW - CfgMinSpeed_FW) /
                             (CfgMaxSpeed_FW - CfgMinSpeed_FW)) * CfgMaxSpeed_FW)

;Scale RPM command to 16 bit 
IF True_M THEN SixteenBitSpeed_FW = SpinSpeedCommand_FW/RPMPerBit_FW

;Factor in gear range
IF True_M THEN SixteenBitSpeed_FW = (SixteenBitSpeed_FW/SpinRangeAdjust_FW)

;Convert to integer word for DAC & I/O display
IF True_M THEN SixteenBitSpeed_W = SixteenBitSpeed_FW

;0 RPM = 32768
;IF command is CW (SpindleDirectionOut = OFF) + 32768
;IF command is CCW (SpindleDirectionOut = OFF), negate SixteenBitSpeed_W
;and add to 32768
IF !SpindleDirectionOut_O THEN SixteenBitSpeed_W = ((SixteenBitSpeed_W*.5) + 32768) 
IF SpindleDirectionOut_O 
  THEN SixteenBitSpeed_W = (((SixteenBitSpeed_W * -1)*.5) + 32768)

; Bound min to 0, max to 65535
IF SixteenBitSpeed_W < 0 THEN SixteenBitSpeed_W = 0
IF SixteenBitSpeed_W > 65535 THEN SixteenBitSpeed_W = 65535

IF True_M THEN WTB SixteenBitSpeed_W SpinAnalogOutBit0_O 16

;=============================================================================
   JogKeysNormalStage
;=============================================================================
;        X+  LATHE                     MILL   Y+       Z+ 
;        |                           4+       |
;   Z- -- -- Z+                          X- -- -- X+
;        |                                    |
;        X-                          4-       Y-       Z-
IF (Ax1PlusJogKey_I  || KbJogAx1Plus_M || UsbMpgAxis1JogPlus_M || SkinJogAx1Plus_SV || SkinJogAx1Ax2Plus_SV ||
    SkinJogAx1PlusAx2Minus_SV || KbJogAx1PlusAx2Minus_M || KbJogAx1Ax2Plus_M) && !Ax1PlusJogDisabled_M &&
    !(IncrContLED_O && FinalFeedOverride_W == 0)
    THEN (DoAx1PlusJog_SV)
IF (Ax1MinusJogKey_I || KbJogAx1Minus_M || UsbMpgAxis1JogMinus_M || SkinJogAx1Minus_SV || SkinJogAx1Ax2Minus_SV ||
    SkinJogAx1MinusAx2Plus_SV || KbJogAx1Ax2Minus_M || KbJogAx1MinusAx2Plus_M) && !Ax1MinusJogDisabled_M &&
    !(IncrContLED_O && FinalFeedOverride_W == 0)
    THEN (DoAx1MinusJog_SV)
IF (Ax2PlusJogKey_I  || KbJogAx2Plus_M || UsbMpgAxis2JogPlus_M || SkinJogAx2Plus_SV || SkinJogAx1Ax2Plus_SV ||
    SkinJogAx1MinusAx2Plus_SV || KbJogAx1Ax2Plus_M || KbJogAx1MinusAx2Plus_M) && !Ax2PlusJogDisabled_M  &&
    !(IncrContLED_O && FinalFeedOverride_W == 0)
    THEN (DoAx2PlusJog_SV)
IF (Ax2MinusJogKey_I || KbJogAx2Minus_M || UsbMpgAxis2JogMinus_M || SkinJogAx2Minus_SV || SkinJogAx1Ax2Minus_SV ||
    SkinJogAx1PlusAx2Minus_SV || KbJogAx1Ax2Minus_M || KbJogAx1PlusAx2Minus_M) && !Ax2MinusJogDisabled_M &&
    !(IncrContLED_O && FinalFeedOverride_W == 0)
    THEN (DoAx2MinusJog_SV)

;=============================================================================
   JogKeysInvert2Stage
;=============================================================================
;        X-  LATHE                    MILL   Y-       Z+ 
;        |                          4+       |
;   Z- -- -- Z+                         X- -- -- X+
;        |                                   |
;        X+                         4-       Y+       Z-
IF (Ax1PlusJogKey_I  || KbJogAx1Plus_M || UsbMpgAxis1JogPlus_M || SkinJogAx1Plus_SV || SkinJogAx1Ax2Plus_SV ||
    SkinJogAx1PlusAx2Minus_SV || KbJogAx1Ax2Plus_M || KbJogAx1PlusAx2Minus_M) && !Ax1PlusJogDisabled_M &&
    !(IncrContLED_O && FinalFeedOverride_W == 0)
    THEN (DoAx1PlusJog_SV)
IF (Ax1MinusJogKey_I || KbJogAx1Minus_M || UsbMpgAxis1JogMinus_M || SkinJogAx1Minus_SV || SkinJogAx1Ax2Minus_SV ||
    SkinJogAx1MinusAx2Plus_SV || KbJogAx1Ax2Minus_M || KbJogAx1MinusAx2Plus_M) && !Ax1MinusJogDisabled_M &&
    !(IncrContLED_O && FinalFeedOverride_W == 0)
    THEN (DoAx1MinusJog_SV)
IF (Ax2MinusJogKey_I  || KbJogAx2Minus_M || UsbMpgAxis2JogPlus_M || SkinJogAx2Minus_SV || SkinJogAx1Ax2Minus_SV ||
    SkinJogAx1PlusAx2Minus_SV || KbJogAx1Ax2Minus_M || KbJogAx1PlusAx2Minus_M) && !Ax2PlusJogDisabled_M &&
    !(IncrContLED_O && FinalFeedOverride_W == 0)
    THEN (DoAx2PlusJog_SV)
IF (Ax2PlusJogKey_I || KbJogAx2Plus_M || UsbMpgAxis2JogMinus_M || SkinJogAx2Plus_SV || SkinJogAx1Ax2Plus_SV ||
    SkinJogAx1MinusAx2Plus_SV || KbJogAx1Ax2Plus_M || KbJogAx1MinusAx2Plus_M) && !Ax2MinusJogDisabled_M &&
    !(IncrContLED_O && FinalFeedOverride_W == 0)
    THEN (DoAx2MinusJog_SV)

;=============================================================================
   JogKeysSwappedStage
;=============================================================================
;        Z+  LATHE                       MILL   X+       Z+ 
;        |                             4+       |
;   X- -- -- X+                            Y- -- -- Y+
;        |                                      |
;        Z-                            4-       X-       Z-
IF (Ax2PlusJogKey_I  || KbJogAx2Plus_M || UsbMpgAxis1JogPlus_M || SkinJogAx2Plus_SV || SkinJogAx1Ax2Plus_SV ||
    SkinJogAx1MinusAx2Plus_SV || KbJogAx1Ax2Plus_M || KbJogAx1MinusAx2Plus_M) && !Ax1PlusJogDisabled_M &&
    !(IncrContLED_O && FinalFeedOverride_W == 0)
    THEN (DoAx1PlusJog_SV)
IF (Ax2MinusJogKey_I || KbJogAx2Minus_M || UsbMpgAxis1JogMinus_M || SkinJogAx2Minus_SV || SkinJogAx1Ax2Minus_SV ||
    SkinJogAx1PlusAx2Minus_SV || KbJogAx1Ax2Minus_M || KbJogAx1PlusAx2Minus_M) && !Ax1MinusJogDisabled_M &&
    !(IncrContLED_O && FinalFeedOverride_W == 0)
    THEN (DoAx1MinusJog_SV)
IF (Ax1PlusJogKey_I  || KbJogAx1Plus_M || UsbMpgAxis2JogPlus_M || SkinJogAx1Plus_SV || SkinJogAx1Ax2Plus_SV ||
    SkinJogAx1PlusAx2Minus_SV || KbJogAx1Ax2Plus_M || KbJogAx1PlusAx2Minus_M) && !Ax2PlusJogDisabled_M  &&
    !(IncrContLED_O && FinalFeedOverride_W == 0)
    THEN (DoAx2PlusJog_SV)
IF (Ax1MinusJogKey_I || KbJogAx1Minus_M || UsbMpgAxis2JogMinus_M || SkinJogAx1Minus_SV || SkinJogAx1Ax2Minus_SV ||
    SkinJogAx1MinusAx2Plus_SV || KbJogAx1Ax2Minus_M || KbJogAx1MinusAx2Plus_M) && !Ax2MinusJogDisabled_M &&
    !(IncrContLED_O && FinalFeedOverride_W == 0)
    THEN (DoAx2MinusJog_SV)

;=============================================================================
   JogKeysSwapAndInvert2Stage
;=============================================================================
;        Z+                             MILL   Y+       Z+ 
;        |                            4+       |
;   X+ -- -- X-                           X+ -- -- X-
;        |                                     |
;        Z-                           4-       Y-       Z-
IF (Ax2PlusJogKey_I  || KbJogAx2Plus_M || UsbMpgAxis1JogPlus_M || SkinJogAx2Plus_SV || SkinJogAx1Ax2Plus_SV ||
    SkinJogAx1MinusAx2Plus_SV || KbJogAx1Ax2Plus_M || KbJogAx1MinusAx2Plus_M) && !Ax1PlusJogDisabled_M &&
    !(IncrContLED_O && FinalFeedOverride_W == 0)
    THEN (DoAx1PlusJog_SV)
IF (Ax2MinusJogKey_I || KbJogAx2Minus_M || UsbMpgAxis1JogMinus_M || SkinJogAx2Minus_SV || SkinJogAx1Ax2Minus_SV ||
    SkinJogAx1PlusAx2Minus_SV || KbJogAx1Ax2Minus_M || KbJogAx1PlusAx2Minus_M) && !Ax1MinusJogDisabled_M &&
    !(IncrContLED_O && FinalFeedOverride_W == 0)
    THEN (DoAx1MinusJog_SV)
IF (Ax1MinusJogKey_I  || KbJogAx1Minus_M || UsbMpgAxis2JogPlus_M || SkinJogAx1Minus_SV || SkinJogAx1Ax2Minus_SV ||
    SkinJogAx1MinusAx2Plus_SV || KbJogAx1Ax2Minus_M || KbJogAx1MinusAx2Plus_M) && !Ax2PlusJogDisabled_M &&
    !(IncrContLED_O && FinalFeedOverride_W == 0)
    THEN (DoAx2PlusJog_SV)
IF (Ax1PlusJogKey_I || KbJogAx1Plus_M || UsbMpgAxis2JogMinus_M || SkinJogAx1Plus_SV || SkinJogAx1Ax2Plus_SV ||
    SkinJogAx1PlusAx2Minus_SV || KbJogAx1Ax2Plus_M || KbJogAx1PlusAx2Minus_M) && !Ax2MinusJogDisabled_M &&
    !(IncrContLED_O && FinalFeedOverride_W == 0)
    THEN (DoAx2MinusJog_SV)

;=============================================================================
                        JogKeysNormalXInvertStage
;=============================================================================
;        X+  LATHE                     MILL   Y+       Z+
;        |                           4+       |
;   Z+ -- -- Z-                          X+ -- -- X-
;        |                                    |
;        X-                          4-       Y-       Z-
IF (Ax1MinusJogKey_I || KbJogAx1Minus_M || UsbMpgAxis1JogPlus_M  || SkinJogAx1Minus_SV || KbJogAx1Ax2Minus_M ||
    KbJogAx1MinusAx2Plus_M || SkinJogAx1Ax2Minus_SV || SkinJogAx1MinusAx2Plus_SV) && !Ax1MinusJogDisabled_M &&
    !(IncrContLED_O && FinalFeedOverride_W == 0)
    THEN (DoAx1PlusJog_SV)
IF (Ax1PlusJogKey_I  || KbJogAx1Plus_M  || UsbMpgAxis1JogMinus_M || SkinJogAx1Plus_SV  || KbJogAx1Ax2Plus_M ||
    KbJogAx1PlusAx2Minus_M || SkinJogAx1Ax2Plus_SV  || SkinJogAx1PlusAx2Minus_SV) && !Ax1PlusJogDisabled_M  &&
    !(IncrContLED_O && FinalFeedOverride_W == 0)
    THEN (DoAx1MinusJog_SV)
IF (Ax2PlusJogKey_I  || KbJogAx2Plus_M  || UsbMpgAxis2JogPlus_M  || SkinJogAx2Plus_SV  || KbJogAx1Ax2Plus_M ||
    KbJogAx1MinusAx2Plus_M || SkinJogAx1Ax2Plus_SV  || SkinJogAx1MinusAx2Plus_SV) && !Ax2PlusJogDisabled_M  &&
    !(IncrContLED_O && FinalFeedOverride_W == 0)
    THEN (DoAx2PlusJog_SV)
IF (Ax2MinusJogKey_I || KbJogAx2Minus_M || UsbMpgAxis2JogMinus_M || SkinJogAx2Minus_SV || KbJogAx1Ax2Minus_M ||
    KbJogAx1PlusAx2Minus_M || SkinJogAx1Ax2Minus_SV || SkinJogAx1PlusAx2Minus_SV) && !Ax2MinusJogDisabled_M &&
    !(IncrContLED_O && FinalFeedOverride_W == 0)
    THEN (DoAx2MinusJog_SV)

;=============================================================================
                        JogKeysInvert2XInvertStage
;=============================================================================
;        X-  LATHE                     MILL   Y-       Z+
;        |                           4+       |
;   Z+ -- -- Z-                          X+ -- -- X-
;        |                                    |
;        X+                          4-       Y+       Z-
IF (Ax1MinusJogKey_I || KbJogAx1Minus_M || UsbMpgAxis1JogPlus_M  || SkinJogAx1Minus_SV || KbJogAx1Ax2Minus_M ||
    KbJogAx1MinusAx2Plus_M || SkinJogAx1Ax2Minus_SV || SkinJogAx1MinusAx2Plus_SV) && !Ax1MinusJogDisabled_M &&
    !(IncrContLED_O && FinalFeedOverride_W == 0)
    THEN (DoAx1PlusJog_SV)
IF (Ax1PlusJogKey_I  || KbJogAx1Plus_M  || UsbMpgAxis1JogMinus_M || SkinJogAx1Plus_SV  || KbJogAx1Ax2Plus_M ||
    KbJogAx1PlusAx2Minus_M || SkinJogAx1Ax2Plus_SV  || SkinJogAx1PlusAx2Minus_SV) && !Ax1PlusJogDisabled_M  &&
    !(IncrContLED_O && FinalFeedOverride_W == 0)
    THEN (DoAx1MinusJog_SV)
IF (Ax2MinusJogKey_I || KbJogAx2Minus_M || UsbMpgAxis2JogPlus_M  || SkinJogAx2Minus_SV || KbJogAx1Ax2Minus_M ||
    KbJogAx1PlusAx2Minus_M || SkinJogAx1Ax2Minus_SV || SkinJogAx1PlusAx2Minus_SV) && !Ax2MinusJogDisabled_M &&
    !(IncrContLED_O && FinalFeedOverride_W == 0)
    THEN (DoAx2PlusJog_SV)
IF (Ax2PlusJogKey_I  || KbJogAx2Plus_M  || UsbMpgAxis2JogMinus_M || SkinJogAx2Plus_SV  || KbJogAx1Ax2Plus_M ||
    KbJogAx1MinusAx2Plus_M || SkinJogAx1Ax2Plus_SV  || SkinJogAx1MinusAx2Plus_SV) && !Ax2PlusJogDisabled_M  &&
    !(IncrContLED_O && FinalFeedOverride_W == 0)
    THEN (DoAx2MinusJog_SV)

;=============================================================================
                        JogKeysSwappedXInvertStage
;=============================================================================
;        Z-  LATHE                     MILL   X-       Z+
;        |                           4+       |
;   X- -- -- X+                          Y- -- -- Y+
;        |                                    |
;        Z+                          4-       X+       Z-
IF (Ax2MinusJogKey_I || KbJogAx2Minus_M || UsbMpgAxis1JogPlus_M  || SkinJogAx2Minus_SV || KbJogAx1Ax2Minus_M ||
    KbJogAx1PlusAx2Minus_M || SkinJogAx1Ax2Minus_SV || SkinJogAx1PlusAx2Minus_SV) && !Ax2MinusJogDisabled_M && !(IncrContLED_O && FinalFeedOverride_W == 0)
    THEN (DoAx1PlusJog_SV)
IF (Ax2PlusJogKey_I  || KbJogAx2Plus_M  || UsbMpgAxis1JogMinus_M || SkinJogAx2Plus_SV  || KbJogAx1Ax2Plus_M ||
    KbJogAx1MinusAx2Plus_M || SkinJogAx1Ax2Plus_SV  || SkinJogAx1MinusAx2Plus_SV) && !Ax2PlusJogDisabled_M  &&
    !(IncrContLED_O && FinalFeedOverride_W == 0)
    THEN (DoAx1MinusJog_SV)
IF (Ax1PlusJogKey_I  || KbJogAx1Plus_M  || UsbMpgAxis2JogPlus_M  || SkinJogAx1Plus_SV  || KbJogAx1Ax2Plus_M ||
    KbJogAx1PlusAx2Minus_M || SkinJogAx1Ax2Plus_SV  || SkinJogAx1PlusAx2Minus_SV) && !Ax1PlusJogDisabled_M  &&
    !(IncrContLED_O && FinalFeedOverride_W == 0)
    THEN (DoAx2PlusJog_SV)
IF (Ax1MinusJogKey_I || KbJogAx1Minus_M || UsbMpgAxis2JogMinus_M || SkinJogAx1Minus_SV || KbJogAx1Ax2Minus_M ||
    KbJogAx1MinusAx2Plus_M || SkinJogAx1Ax2Minus_SV || SkinJogAx1MinusAx2Plus_SV) && !Ax1MinusJogDisabled_M &&
    !(IncrContLED_O && FinalFeedOverride_W == 0)
    THEN (DoAx2MinusJog_SV)

;=============================================================================
                    JogKeysSwapandInvert2XInvertStage
;=============================================================================
;        Z-  LATHE                     MILL   X-       Z+
;        |                           4+       |
;   X+ -- -- X-                          Y+ -- -- Y-
;        |                                    |
;        Z+                          4-       X+       Z-
IF (Ax2MinusJogKey_I || KbJogAx2Minus_M || UsbMpgAxis1JogPlus_M  || SkinJogAx2Minus_SV || KbJogAx1Ax2Minus_M ||
    KbJogAx1PlusAx2Minus_M || SkinJogAx1Ax2Minus_SV || SkinJogAx1PlusAx2Minus_SV) && !Ax2MinusJogDisabled_M &&
    !(IncrContLED_O && FinalFeedOverride_W == 0)
    THEN (DoAx1PlusJog_SV)
IF (Ax2PlusJogKey_I  || KbJogAx2Plus_M  || UsbMpgAxis1JogMinus_M || SkinJogAx2Plus_SV  || KbJogAx1Ax2Plus_M ||
    KbJogAx1MinusAx2Plus_M || SkinJogAx1Ax2Plus_SV  || SkinJogAx1MinusAx2Plus_SV) && !Ax2PlusJogDisabled_M  &&
    !(IncrContLED_O && FinalFeedOverride_W == 0)
    THEN (DoAx1MinusJog_SV)
IF (Ax1MinusJogKey_I || KbJogAx1Minus_M || UsbMpgAxis2JogPlus_M  || SkinJogAx1Minus_SV || KbJogAx1Ax2Minus_M ||
    KbJogAx1MinusAx2Plus_M || SkinJogAx1Ax2Minus_SV || SkinJogAx1MinusAx2Plus_SV) && !Ax1MinusJogDisabled_M &&
    !(IncrContLED_O && FinalFeedOverride_W == 0)
    THEN (DoAx2PlusJog_SV)
IF (Ax1PlusJogKey_I  || KbJogAx1Plus_M  || UsbMpgAxis2JogMinus_M || SkinJogAx1Plus_SV  || KbJogAx1Ax2Plus_M ||
    KbJogAx1PlusAx2Minus_M || SkinJogAx1Ax2Plus_SV  || SkinJogAx1PlusAx2Minus_SV) && !Ax1PlusJogDisabled_M &&
    !(IncrContLED_O  && FinalFeedOverride_W == 0)
    THEN (DoAx2MinusJog_SV)

;=============================================================================
  CheckCycloneStatusStage
;=============================================================================
; Due to amount of time it takes to retrieve data from the cyclone, this stage
; is only called few times per second to help reduce scan time of the main PLC
; program.

; Read Axis1FiberOk_M through Axis8FiberOk_M
;IF True_M THEN WTB SV_PC_CYCLONE_STATUS_2 Axis1FiberOk_M

; Generate some messages for fiber or wire to MPU11 having issues
IF SV_X_AXIS_VALID && !SV_X_AXIS_DRIVE_ONLINE THEN FaultMsg_W = X_AXIS_INFLT_C, SET DriveComFltIn_M
IF SV_Y_AXIS_VALID && !SV_Y_AXIS_DRIVE_ONLINE THEN FaultMsg_W = Y_AXIS_INFLT_C, SET DriveComFltIn_M
IF SV_Z_AXIS_VALID && !SV_Z_AXIS_DRIVE_ONLINE THEN FaultMsg_W = Z_AXIS_INFLT_C, SET DriveComFltIn_M
IF SV_A_AXIS_VALID && !SV_A_AXIS_DRIVE_ONLINE THEN FaultMsg_W = A_AXIS_INFLT_C, SET DriveComFltIn_M
IF SV_B_AXIS_VALID && !SV_B_AXIS_DRIVE_ONLINE THEN FaultMsg_W = B_AXIS_INFLT_C, SET DriveComFltIn_M
IF SV_C_AXIS_VALID && !SV_C_AXIS_DRIVE_ONLINE THEN FaultMsg_W = C_AXIS_INFLT_C, SET DriveComFltIn_M
IF SV_U_AXIS_VALID && !SV_U_AXIS_DRIVE_ONLINE THEN FaultMsg_W = U_AXIS_INFLT_C, SET DriveComFltIn_M
IF SV_V_AXIS_VALID && !SV_V_AXIS_DRIVE_ONLINE THEN FaultMsg_W = V_AXIS_INFLT_C, SET DriveComFltIn_M
IF SV_W_AXIS_VALID && !SV_W_AXIS_DRIVE_ONLINE THEN FaultMsg_W = W_AXIS_INFLT_C, SET DriveComFltIn_M

; Generate some messages for fiber or wire to drive having issues
IF SV_X_AXIS_VALID && SV_X_AXIS_DRIVE_ONLINE && !SV_X_AXIS_FIBER_OK && SV_MASTER_ENABLE
  THEN FaultMsg_W = X_AXIS_OUTFLT_C, SET DriveComFltOut_M
IF SV_Y_AXIS_VALID && SV_Y_AXIS_DRIVE_ONLINE && !SV_Y_AXIS_FIBER_OK && SV_MASTER_ENABLE
  THEN FaultMsg_W = Y_AXIS_OUTFLT_C, SET DriveComFltOut_M
IF SV_Z_AXIS_VALID && SV_Z_AXIS_DRIVE_ONLINE && !SV_Z_AXIS_FIBER_OK && SV_MASTER_ENABLE
  THEN FaultMsg_W = Z_AXIS_OUTFLT_C, SET DriveComFltOut_M
IF SV_A_AXIS_VALID && SV_A_AXIS_DRIVE_ONLINE && !SV_A_AXIS_FIBER_OK && SV_MASTER_ENABLE
  THEN FaultMsg_W = A_AXIS_OUTFLT_C, SET DriveComFltOut_M
IF SV_B_AXIS_VALID && SV_B_AXIS_DRIVE_ONLINE && !SV_B_AXIS_FIBER_OK && SV_MASTER_ENABLE
  THEN FaultMsg_W = B_AXIS_OUTFLT_C, SET DriveComFltOut_M
IF SV_C_AXIS_VALID && SV_C_AXIS_DRIVE_ONLINE && !SV_C_AXIS_FIBER_OK && SV_MASTER_ENABLE
  THEN FaultMsg_W = C_AXIS_OUTFLT_C, SET DriveComFltOut_M
IF SV_U_AXIS_VALID && SV_U_AXIS_DRIVE_ONLINE && !SV_U_AXIS_FIBER_OK && SV_MASTER_ENABLE
  THEN FaultMsg_W = U_AXIS_OUTFLT_C, SET DriveComFltOut_M
IF SV_V_AXIS_VALID && SV_V_AXIS_DRIVE_ONLINE && !SV_V_AXIS_FIBER_OK && SV_MASTER_ENABLE
  THEN FaultMsg_W = V_AXIS_OUTFLT_C, SET DriveComFltOut_M
IF SV_W_AXIS_VALID && SV_W_AXIS_DRIVE_ONLINE && !SV_W_AXIS_FIBER_OK && SV_MASTER_ENABLE
  THEN FaultMsg_W = W_AXIS_OUTFLT_C, SET DriveComFltOut_M

IF !EStopOk_M THEN RST DriveComFltIn_M, RST DriveComFltOut_M
IF DriveComFltOut_M || DriveComFltIn_M THEN SET AxisFault_M

;check PLC and JogBoard status bits
IF True_M THEN CycloneStatus_W = SV_PC_CYCLONE_STATUS_1,
             BITTST CycloneStatus_W 21 PLCBusExtDevEn_M,
             BITTST CycloneStatus_W 23 JogPanelOnline_M

;check PLC input fiber
IF !SV_PLC_BUS_ONLINE THEN FaultMsg_W = PLC_INFLT_C,
                           RST PLCBus_Oe_M, SET PLCFault_M

;check PLC output fiber
IF SV_PLC_BUS_ONLINE && PLCBus_Oe_M && !PLCBusExtDevEn_M
  THEN FaultMsg_W = PLC_OUTFLT_C, SET PLCFault_M

;clear PLC errors
IF PLCFault_M && SV_PLC_BUS_ONLINE && PLCBusExtDevEn_M && !EStopOk_M
  THEN RST PLCFault_M, InfoMsg_W = PLC_FLT_CLR_C, SET PLCBus_Oe_M

;check JogBoard incoming communications
IF SV_JOG_LINK_ONLINE THEN (JogLinkOk_M)
IF JogPanelRequired_M && !JogLinkOk_M
  THEN FaultMsg_W = JOGBOARD_INFLT_C, SET OtherFault_M

;check JogBoard outgoing communications
IF JogPanelRequired_M && JogLinkOk_M && !JogPanelOnline_M
  THEN FaultMsg_W = JOGBOARD_OUTFLT_C, SET OtherFault_M

; Check MiniPLC board communications
IF True_M THEN MiniPLCStatus_W = SV_PC_MINI_PLC_ONLINE,
             P900Value_W = SV_MACHINE_PARAMETER_900
IF MiniPLCStatus_W != P900Value_W THEN SET MiniPLCErrorStage

IF True_M THEN RST CheckCycloneStatusStage

;=============================================================================
						MiniPLCErrorStage
;=============================================================================
IF True_M THEN WTB P900Value_W MiniPLCExpected1_M 8,
             WTB MiniPLCStatus_W MiniPLCOk1_M 8

IF MiniPLCExpected1_M && !MiniPLCOk1_M
  THEN FaultMsg_W = MINI_PLC_1_FLT_MSG_C, SET OtherFault_M
IF MiniPLCExpected2_M && !MiniPLCOk2_M
  THEN FaultMsg_W = MINI_PLC_2_FLT_MSG_C, SET OtherFault_M
IF MiniPLCExpected3_M && !MiniPLCOk3_M
  THEN FaultMsg_W = MINI_PLC_3_FLT_MSG_C, SET OtherFault_M
IF MiniPLCExpected4_M && !MiniPLCOk4_M
  THEN FaultMsg_W = MINI_PLC_4_FLT_MSG_C, SET OtherFault_M
IF MiniPLCExpected5_M && !MiniPLCOk5_M
  THEN FaultMsg_W = MINI_PLC_5_FLT_MSG_C, SET OtherFault_M
IF MiniPLCExpected6_M && !MiniPLCOk6_M
  THEN FaultMsg_W = MINI_PLC_6_FLT_MSG_C, SET OtherFault_M
IF MiniPLCExpected7_M && !MiniPLCOk7_M
  THEN FaultMsg_W = MINI_PLC_7_FLT_MSG_C, SET OtherFault_M
IF MiniPLCExpected8_M && !MiniPLCOk8_M
  THEN FaultMsg_W = MINI_PLC_8_FLT_MSG_C, SET OtherFault_M

IF MiniPLCOk1_M && !MiniPLCExpected1_M THEN InfoMsg_W = MINI_PLC_1_WARNING_C
IF MiniPLCOk2_M && !MiniPLCExpected2_M THEN InfoMsg_W = MINI_PLC_2_WARNING_C
IF MiniPLCOk3_M && !MiniPLCExpected3_M THEN InfoMsg_W = MINI_PLC_3_WARNING_C
IF MiniPLCOk4_M && !MiniPLCExpected4_M THEN InfoMsg_W = MINI_PLC_4_WARNING_C
IF MiniPLCOk5_M && !MiniPLCExpected5_M THEN InfoMsg_W = MINI_PLC_5_WARNING_C
IF MiniPLCOk6_M && !MiniPLCExpected6_M THEN InfoMsg_W = MINI_PLC_6_WARNING_C
IF MiniPLCOk7_M && !MiniPLCExpected7_M THEN InfoMsg_W = MINI_PLC_7_WARNING_C
IF MiniPLCOk8_M && !MiniPLCExpected8_M THEN InfoMsg_W = MINI_PLC_8_WARNING_C

IF True_M THEN RST MiniPLCErrorStage

;=============================================================================
						AxesEnableStage
;=============================================================================
;SV_DRIVE_STATUS_1
;  5 = alarm bit 3, 6 = alarm bit 2, 7 = alarm bit 1, 8 = /TGON,
;  9 = brake state, 10 = /S_RDY, 11 = quadrature Error, 12 = direction,
;  13 = Index pulse, 14 = diff. error, 15 = drive fault
;IF True_M THEN WTB SV_DRIVE_STATUS_1 Axis1StatusBit0_M 16,
;               WTB SV_DRIVE_STATUS_2 Axis2StatusBit0_M 16,
;               WTB SV_DRIVE_STATUS_3 Axis3StatusBit0_M 16,
;               WTB SV_DRIVE_STATUS_4 Axis4StatusBit0_M 16,
;               WTB SV_DRIVE_STATUS_5 Axis5StatusBit0_M 16,
;			   WTB SV_DRIVE_STATUS_6 Axis6StatusBit0_M 16,
;			   WTB SV_DRIVE_STATUS_7 Axis7StatusBit0_M 16,
;			   WTB SV_DRIVE_STATUS_8 Axis8StatusBit0_M 16

IF True_M THEN WTB SV_X_AXIS_DRIVE_STATUS XAxisStatusBit0_M 16,
               WTB SV_Y_AXIS_DRIVE_STATUS YAxisStatusBit0_M 16,
               WTB SV_Z_AXIS_DRIVE_STATUS ZAxisStatusBit0_M 16,
               WTB SV_A_AXIS_DRIVE_STATUS AAxisStatusBit0_M 16,
               WTB SV_B_AXIS_DRIVE_STATUS BAxisStatusBit0_M 16,
               WTB SV_C_AXIS_DRIVE_STATUS CAxisStatusBit0_M 16,
               WTB SV_U_AXIS_DRIVE_STATUS UAxisStatusBit0_M 16,
               WTB SV_V_AXIS_DRIVE_STATUS VAxisStatusBit0_M 16,
               WTB SV_W_AXIS_DRIVE_STATUS WAxisStatusBit0_M 16

IF !XAxisDriveALM_M THEN (XAxisDriveOk_M)
IF !YAxisDriveALM_M THEN (YAxisDriveOk_M)
IF !ZAxisDriveALM_M THEN (ZAxisDriveOk_M)
IF !AAxisDriveALM_M THEN (AAxisDriveOk_M)
IF !BAxisDriveALM_M THEN (BAxisDriveOk_M)
IF !CAxisDriveALM_M THEN (CAxisDriveOk_M)
IF !UAxisDriveALM_M THEN (UAxisDriveOk_M)
IF !VAxisDriveALM_M THEN (VAxisDriveOk_M)
IF !WAxisDriveALM_M THEN (WAxisDriveOk_M)

;Report external drive faults
;For Non-ACDC Drives
IF SV_X_AXIS_VALID && SV_X_AXIS_POWERED && !XAxisDriveOk_M && (SV_X_AXIS_DRIVE_TYPE != 4)
  THEN FaultMsg_W = X_AXIS_DRIVE_FAULT_C,
    SET AxisFault_M
IF SV_Y_AXIS_VALID && SV_Y_AXIS_POWERED && !YAxisDriveOk_M && (SV_Y_AXIS_DRIVE_TYPE != 4)
  THEN FaultMsg_W = Y_AXIS_DRIVE_FAULT_C,
    SET AxisFault_M
IF SV_Z_AXIS_VALID && SV_Z_AXIS_POWERED && !ZAxisDriveOk_M && (SV_Z_AXIS_DRIVE_TYPE != 4)
  THEN FaultMsg_W = Z_AXIS_DRIVE_FAULT_C,
    SET AxisFault_M
IF SV_A_AXIS_VALID && SV_A_AXIS_POWERED && !AAxisDriveOk_M && (SV_A_AXIS_DRIVE_TYPE != 4)
  THEN FaultMsg_W = A_AXIS_DRIVE_FAULT_C,
    SET AxisFault_M
IF SV_B_AXIS_VALID && SV_B_AXIS_POWERED && !BAxisDriveOk_M && (SV_B_AXIS_DRIVE_TYPE != 4)
  THEN FaultMsg_W = B_AXIS_DRIVE_FAULT_C,
    SET AxisFault_M
IF SV_C_AXIS_VALID && SV_C_AXIS_POWERED && !CAxisDriveOk_M && (SV_C_AXIS_DRIVE_TYPE != 4)
  THEN FaultMsg_W = C_AXIS_DRIVE_FAULT_C,
    SET AxisFault_M
IF SV_U_AXIS_VALID && SV_U_AXIS_POWERED && !UAxisDriveOk_M && (SV_U_AXIS_DRIVE_TYPE != 4)
  THEN FaultMsg_W = U_AXIS_DRIVE_FAULT_C,
    SET AxisFault_M
IF SV_V_AXIS_VALID && SV_V_AXIS_POWERED && !VAxisDriveOk_M && (SV_V_AXIS_DRIVE_TYPE != 4)
  THEN FaultMsg_W = V_AXIS_DRIVE_FAULT_C,
    SET AxisFault_M
IF SV_W_AXIS_VALID && SV_W_AXIS_POWERED && !WAxisDriveOk_M && (SV_W_AXIS_DRIVE_TYPE != 4)
  THEN FaultMsg_W = W_AXIS_DRIVE_FAULT_C,
    SET AxisFault_M
	
; Handle ACDC Fatal Errors
; On a fatal error, the AC1 will set the FatalError bit in the drive status.
; The AC1 will clear the FatalError bit on the rising edge of
; SV_MASTER_ENABLE, but it may be immediately set again if the fatal
; error condition persists. 
;
; The PLC is not guaranteed to see another rising edge of the fatal error bit
; since (1) the drive status packets are updated at 250Hz
; and the PLC runs at 50Hz, and 2) even if monitored in a fast stage,
; the AC1 can re-generate an error at 4000Hz before a new status from
; the AC1 drive is ever sent.
; 
; The PLC therefore will catch the error on the rising edge of the
; fatal error bit of any AC1 axis, or if SV_MASTER_ENABLE has been on for 
; one second and the fatal error bit is still set on any axis.

; Check the fatal error bit from each drive
IF True_M THEN BITTST SV_HSC_DRIVE_1_STATUS_4 0 AC1Drive1FatalError_M
IF True_M THEN BITTST SV_HSC_DRIVE_2_STATUS_4 0 AC1Drive2FatalError_M
IF True_M THEN BITTST SV_HSC_DRIVE_3_STATUS_4 0 AC1Drive3FatalError_M
IF True_M THEN BITTST SV_HSC_DRIVE_4_STATUS_4 0 AC1Drive4FatalError_M
IF True_M THEN BITTST SV_HSC_DRIVE_5_STATUS_4 0 AC1Drive5FatalError_M
IF True_M THEN BITTST SV_HSC_DRIVE_6_STATUS_4 0 AC1Drive6FatalError_M
IF True_M THEN BITTST SV_HSC_DRIVE_7_STATUS_4 0 AC1Drive7FatalError_M
IF True_M THEN BITTST SV_HSC_DRIVE_8_STATUS_4 0 AC1Drive8FatalError_M

; Maintain  a timer that expires one second after SV_MASTER_ENABLE is turned on,
; so that we can check if the FatalError bit is not getting cleared by the ACDC.
IF !SV_MASTER_ENABLE THEN RST MasterEnable_T
IF SV_MASTER_ENABLE THEN MasterEnable_T = 1000, set MasterEnable_T

IF AC1Drive1FatalError_M || AC1Drive2FatalError_M || AC1Drive3FatalError_M 
    || AC1Drive4FatalError_M || AC1Drive5FatalError_M THEN (AC1FatalErrorPD_PD)

;NOTE: SV_HSC_DRIVE_1_STATUS_4 through SV_HSC_DRIVE_8_STATUS_4 refer only to 
;      the DRIVE numbers and are not necessarily associated with Axis1-Axis8
;      respectively. For example, if the machine has 4 axes mapped 300 = 2, 
;      301 = 3, 302 = 4, 303 = 1 the following logic will not perform as you 
;      might expect:
;
;IF SV_AXIS_VALID_1 && AC1Axis1FatalError_M && (AC1FatalErrorPD || MasterEnable_T)
;  THEN SET AC1FatalError_M, ErrorMsg_W = AXIS1_DRIVE_FAULT  
;
; The above logic will check if DRIVE1 has an error when Axis1 is valid,
; but DRIVE1 is mapped to AXIS4 ( 303 = 1 ). To correct this, pair 
; SV_AXIS_VALID_# with SV_HSC_DRIVE_#... based on the drive mapping:

IF SV_X_AXIS_VALID && MEM[SV_X_AXIS_DRIVE_NUMBER + 70] && (SV_X_AXIS_DRIVE_TYPE == 4) &&
  (AC1FatalErrorPD_PD || MasterEnable_T) THEN SET AC1FatalError_M, ErrorMsg_W = X_AXIS_DRIVE_FAULT_C
IF SV_Y_AXIS_VALID && MEM[SV_Y_AXIS_DRIVE_NUMBER + 70] && (SV_Y_AXIS_DRIVE_TYPE == 4) &&
  (AC1FatalErrorPD_PD || MasterEnable_T) THEN SET AC1FatalError_M, ErrorMsg_W = Y_AXIS_DRIVE_FAULT_C
IF SV_Z_AXIS_VALID && MEM[SV_Z_AXIS_DRIVE_NUMBER + 70] && (SV_Z_AXIS_DRIVE_TYPE == 4) &&
  (AC1FatalErrorPD_PD || MasterEnable_T) THEN SET AC1FatalError_M, ErrorMsg_W = Z_AXIS_DRIVE_FAULT_C
IF SV_A_AXIS_VALID && MEM[SV_A_AXIS_DRIVE_NUMBER + 70] && (SV_A_AXIS_DRIVE_TYPE == 4) &&
  (AC1FatalErrorPD_PD || MasterEnable_T) THEN SET AC1FatalError_M, ErrorMsg_W = A_AXIS_DRIVE_FAULT_C
IF SV_B_AXIS_VALID && MEM[SV_B_AXIS_DRIVE_NUMBER + 70] && (SV_B_AXIS_DRIVE_TYPE == 4) &&
  (AC1FatalErrorPD_PD || MasterEnable_T) THEN SET AC1FatalError_M, ErrorMsg_W = B_AXIS_DRIVE_FAULT_C
IF SV_C_AXIS_VALID && MEM[SV_C_AXIS_DRIVE_NUMBER + 70] && (SV_C_AXIS_DRIVE_TYPE == 4) &&
  (AC1FatalErrorPD_PD || MasterEnable_T) THEN SET AC1FatalError_M, ErrorMsg_W = C_AXIS_DRIVE_FAULT_C
IF SV_U_AXIS_VALID && MEM[SV_U_AXIS_DRIVE_NUMBER + 70] && (SV_U_AXIS_DRIVE_TYPE == 4) &&
  (AC1FatalErrorPD_PD || MasterEnable_T) THEN SET AC1FatalError_M, ErrorMsg_W = U_AXIS_DRIVE_FAULT_C
IF SV_V_AXIS_VALID && MEM[SV_V_AXIS_DRIVE_NUMBER + 70] && (SV_V_AXIS_DRIVE_TYPE == 4) &&
  (AC1FatalErrorPD_PD || MasterEnable_T) THEN SET AC1FatalError_M, ErrorMsg_W = V_AXIS_DRIVE_FAULT_C
IF SV_W_AXIS_VALID && MEM[SV_W_AXIS_DRIVE_NUMBER + 70] && (SV_W_AXIS_DRIVE_TYPE == 4) &&
  (AC1FatalErrorPD_PD || MasterEnable_T) THEN SET AC1FatalError_M, ErrorMsg_W = W_AXIS_DRIVE_FAULT_C

;Brake Release
IF SV_Z_AXIS_VALID && SV_Z_AXIS_POWERED THEN (ZBrakeRelease_O)


;IF !EStopOk_M THEN RST AxisFault_M

;read the status bits
IF True_M THEN SET CycloneStatus_T
IF CycloneStatus_T THEN SET CheckCycloneStatusStage, RST CycloneStatus_T

;allow MPU11 to turn on drives if no errors
IF !PLCFault_M THEN SET SV_MASTER_ENABLE
; (SV_MASTER_ENABLE will be turned off by stalls and other
;  errors in the Fault-handling section of MainStage, below.)

;==============================================================================
                                LoadMeterStage
;==============================================================================
IF True_M THEN BTW DriveMeter1_W DriveAnalogInput1_I 16,
               BTW DriveMeter2_W DriveAnalogInput2_I 16,
               BTW DriveMeter3_W DriveAnalogInput3_I 16,
               BTW DriveMeter4_W DriveAnalogInput4_I 16,
               BTW SpindleMeter_W SpindleAnalogInput5_I 16

;sign extend
IF DriveMeter1_W > 32767 then DriveMeter1_W = DriveMeter1_W - 65536
IF DriveMeter2_W > 32767 then DriveMeter2_W = DriveMeter2_W - 65536
IF DriveMeter3_W > 32767 then DriveMeter3_W = DriveMeter3_W - 65536
IF DriveMeter4_W > 32767 then DriveMeter4_W = DriveMeter4_W - 65536
IF SpindleMeter_W > 32767 then SpindleMeter_W = SpindleMeter_W - 65536

;Optic Directs
; Should not be sign extended, so are assigned after.
IF SV_DRIVE_TYPE_1 == 9 THEN BTW DriveMeter1_W OpticDirect1_ANin 16
IF SV_DRIVE_TYPE_2 == 9 THEN BTW DriveMeter2_W OpticDirect2_ANin 16
IF SV_DRIVE_TYPE_3 == 9 THEN BTW DriveMeter3_W OpticDirect3_ANin 16
IF SV_DRIVE_TYPE_4 == 9 THEN BTW DriveMeter4_W OpticDirect4_ANin 16
IF SV_DRIVE_TYPE_5 == 9 THEN BTW DriveMeter5_W OpticDirect5_ANin 16

; EtherCAT drive typical, but not guaranteed, information:
; load in 0.1% units 
; 100% is rated load, full scale is 300%
; signed 16 bit value
IF SV_DRIVE_TYPE_1 == 9 THEN DriveMeter1_W = (100 * (DriveMeter1_W - 2048)) / 1638
IF SV_DRIVE_TYPE_1 != 9 THEN DriveMeter1_W = (100 * DriveMeter1_W) / 1638
IF SV_DRIVE_TYPE_2 == 9 THEN DriveMeter2_W = (100 * (DriveMeter2_W - 2048)) / 1638
IF SV_DRIVE_TYPE_2 != 9 THEN DriveMeter2_W = (100 * DriveMeter2_W) / 1638
IF SV_DRIVE_TYPE_3 == 9 THEN DriveMeter3_W = (100 * (DriveMeter3_W - 2048)) / 1638
IF SV_DRIVE_TYPE_3 != 9 THEN DriveMeter3_W = (100 * DriveMeter3_W) / 1638
IF SV_DRIVE_TYPE_4 == 9 THEN DriveMeter4_W = (100 * (DriveMeter4_W - 2048)) / 1638
IF SV_DRIVE_TYPE_4 != 9 THEN DriveMeter4_W = (100 * DriveMeter4_W) / 1638
IF SV_DRIVE_TYPE_5 == 9 THEN DriveMeter5_W = (100 * (DriveMeter5_W - 2048)) / 1638
IF SV_DRIVE_TYPE_5 != 9 THEN DriveMeter5_W = (100 * DriveMeter5_W) / 1638

IF True_M THEN SpindleMeter_W = (100 * SpindleMeter_W) / 2048

IF True_M THEN SV_METER_1 = DriveMeter1_W,
               SV_METER_2 = DriveMeter2_W,
               SV_METER_3 = DriveMeter3_W,
               SV_METER_4 = DriveMeter4_W,
               SV_METER_5 = DriveMeter5_W
			   
IF True_M THEN SV_SPINDLE_METER = SpindleMeter_W

;=============================================================================
						MainStage
;=============================================================================
;Do gather if commanded (uncomment and recompile for debugging purposes)
;IF Aux11Key THEN (Aux11KeyPD)
;IF Aux11KeyPD THEN (SV_TRIGGER_PLOT_DUMP)

;----------------------------------------------------------------
;           EStop and Reset Section
;----------------------------------------------------------------
;Set State of VCP Reset Button
IF SkinResetKey_M_SV && EStopOk_I THEN (SetResetPD_PD)
IF EStopOk_I THEN (EStopOkPD_PD)
IF (SetResetPD_PD ^ ResetSet_M) && !EStopOkPD_PD THEN (ResetSet_M)

;Set Bit to Activate Estop. 
IF !(!EStopOk_I || ResetSet_M) THEN (EStopOk_M)

IF !EStopOk_M THEN (SkinResetSet_O), (SkinResetSet_M_SV)

;Send SV to CNC12 to Display Message
IF !EStopOk_I THEN (SV_ESTOP_PRESSED)
IF ResetSet_M THEN (SV_RESET_PRESSED)

;----------------------------------------------------------------
;           Busellato Router Section
;----------------------------------------------------------------
;outputs
IF M60_SV THEN (SpindleCollet_O)
IF M62_SV THEN (LeftFence_O)
IF M64_SV THEN (FrontFence_O)
IF M66_SV THEN (ClampArea_O)
IF M70_SV THEN (SpindleGoHigh_O)
IF M71_SV THEN (SpindleGoMed_O)
IF M72_SV THEN (SpindleGoLow_O)

IF SpinHeightHigh_I THEN (SpindleIsHigh_M)
IF SpinHeightMed_I THEN (SpindleIsMed_M)
IF SpinHeightLow_I THEN (SpindleIsLow_M)

IF M70_SV && SpindleIsHigh_M || M71_SV && SpindleIsMed_M || 
	M72_SV && SpindleIsLow_M THEN SET SpindleMoveComplete_M, 
		RST M70_SV, RST M71_SV, RST M72_SV

;----------------------------------------------------------------
;           Probe protection while jogging
;----------------------------------------------------------------
; If the probe comes to be tripped while a jogging move is active,
; then trigger an error (stop jog and output message),
; and also disable jogging in the direction it was going.
IF MechanicalProbe_I && ProbeProtectionEnable_M THEN (ProbePD_PD)

IF ProbePD_PD && DoAx1PlusJog_SV THEN SET Ax1PlusJogDisabled_M,
                                      SET Ax2MinusJogDisabled_M,
                                      SET Ax2PlusJogDisabled_M,
                                      SET Ax4PlusJogDisabled_M,
                                      SET Ax4MinusJogDisabled_M
IF ProbePD_PD && DoAx1MinusJog_SV THEN SET Ax1MinusJogDisabled_M,
                                       SET Ax2MinusJogDisabled_M,
                                       SET Ax2PlusJogDisabled_M,
                                       SET Ax4PlusJogDisabled_M,
                                       SET Ax4MinusJogDisabled_M
IF ProbePD_PD && DoAx2PlusJog_SV THEN SET Ax2PlusJogDisabled_M,
                                      SET Ax1MinusJogDisabled_M,
                                      SET Ax1PlusJogDisabled_M,
                                      SET Ax4PlusJogDisabled_M,
                                      SET Ax4MinusJogDisabled_M
IF ProbePD_PD && DoAx2MinusJog_SV THEN SET Ax2MinusJogDisabled_M,
                                       SET Ax1MinusJogDisabled_M,
                                       SET Ax1PlusJogDisabled_M,
                                       SET Ax4PlusJogDisabled_M,
                                       SET Ax4MinusJogDisabled_M
IF ProbePD_PD && DoAx4PlusJog_SV THEN SET Ax4PlusJogDisabled_M,
                                      SET Ax1PlusJogDisabled_M,
                                      SET Ax1MinusJogDisabled_M,
                                      SET Ax2PlusJogDisabled_M,
                                      SET Ax2MinusJogDisabled_M
IF ProbePD_PD && DoAx4MinusJog_SV THEN SET Ax4MinusJogDisabled_M,
                                       SET Ax1PlusJogDisabled_M,
                                       SET Ax1MinusJogDisabled_M,
                                       SET Ax2PlusJogDisabled_M,
                                       SET Ax2MinusJogDisabled_M
IF ProbePD_PD THEN SET Ax3MinusJogDisabled_M

;Display Error when Probe Tripped while Jogging
IF ProbePD_PD && !JogProbeFault_M && (DoAx1PlusJog_SV || DoAx1MinusJog_SV ||
   DoAx2PlusJog_SV || DoAx2MinusJog_SV || DoAx3PlusJog_SV || DoAx3MinusJog_SV ||
   DoAx4PlusJog_SV || DoAx4MinusJog_SV || DoAx5PlusJog_SV || DoAx5MinusJog_SV)
  THEN (JogProbeFaultPD_PD)

IF JogProbeFaultPD_PD THEN SET JogProbeFault_M,
                        SET ErrorFlag_M,
                        ErrorMsg_W = PROBE_JOG_TRIP_MSG_C
						
;Before enabling the axis jog keys, ensure operator is no longer pressing a jog key.
;Prevents the machine from moving in the situation the probe tip snaps while jogging.
IF (Ax1PlusJogKey_I  || KbJogAx1Plus_M || SkinJogAx1Plus_SV || UsbMpgAxis1JogPlus_M) ||
   (Ax1MinusJogKey_I  || KbJogAx1Minus_M || SkinJogAx1Minus_SV || UsbMpgAxis1JogMinus_M) ||
   (Ax2PlusJogKey_I  || KbJogAx2Plus_M || SkinJogAx2Plus_SV || UsbMpgAxis2JogPlus_M) ||
   (Ax2MinusJogKey_I  || KbJogAx2Minus_M || SkinJogAx2Minus_SV || UsbMpgAxis2JogMinus_M) ||
   (Ax3PlusJogKey_I  || KbJogAx3Plus_M || SkinJogAx3Plus_SV || UsbMpgAxis3JogPlus_M) ||
   (Ax3MinusJogKey_I  || KbJogAx3Minus_M || SkinJogAx3Minus_SV || UsbMpgAxis3JogMinus_M) ||
   (Ax4PlusJogKey_I  || KbJogAx4Plus_M || SkinJogAx4Plus_SV || UsbMpgAxis4JogPlus_M) ||
   (Ax4MinusJogKey_I  || KbJogAx4Minus_M || SkinJogAx4Minus_SV || UsbMpgAxis4JogMinus_M) ||
   (SkinJogAx5Plus_SV || UsbMpgAxis5JogPlus_M) || (SkinJogAx5Minus_SV || UsbMpgAxis5JogMinus_M) ||
   (SkinJogAx6Plus_SV || UsbMpgAxis6JogPlus_M) || (SkinJogAx6Minus_SV || UsbMpgAxis6JogMinus_M) ||
   (UsbMpgAxis7JogPlus_M || UsbMpgAxis7JogMinus_M) || (UsbMpgAxis8JogPlus_M || UsbMpgAxis8JogMinus_M) ||
   (SkinJogAx1Ax2Plus_SV || SkinJogAx1Ax2Minus_SV || SkinJogAx1PlusAx2Minus_SV || SkinJogAx1MinusAx2Plus_SV) ||
   (KbJogAx1Ax2Plus_M    || KbJogAx1Ax2Minus_M     || KbJogAx1PlusAx2Minus_M    || KbJogAx1MinusAx2Plus_M)
THEN (JogKeyPressed_M)

IF !MechanicalProbe_I && !JogKeyPressed_M THEN RST JogProbeFault_M,
                                               RST Ax1PlusJogDisabled_M,
                                               RST Ax1MinusJogDisabled_M,
                                               RST Ax2PlusJogDisabled_M,
                                               RST Ax2MinusJogDisabled_M,
                                               RST Ax3MinusJogDisabled_M,
                                               RST Ax4PlusJogDisabled_M,
                                               RST Ax4MinusJogDisabled_M

; If the probe comes to be tripped while no program cycle is running,
; then save the previous jog mode (fast/slow) and force slow mode.
;IF MechanicalProbe_I && !SV_PROGRAM_RUNNING && !JogModeSaved_M
;  THEN (SaveJogModePD_PD),
;       SET JogModeSaved_M
;IF SaveJogModePD_PD && FastSlowLED_O THEN SET LastProbeMode_M
;IF SaveJogModePD_PD && !FastSlowLED_O THEN RST LastProbeMode_M
IF MechanicalProbe_I && !SV_PROGRAM_RUNNING && ProbeProtectionEnable_M THEN SET FastSlowLED_O

; Once the probe clears, restore the saved mode and reset
;IF !MechanicalProbe_I && JogModeSaved_M && !LastProbeMode_M && !JogKeyPressed_M
;  THEN RST FastSlowLED_O, RST JogModeSaved_M
	   
;------------------------------------------------------------------------------
;                            USB Mpg Section
;------------------------------------------------------------------------------
;Word to bit for usb mpg operation
IF True_M THEN WTB SV_USB_MPG_BUTTON_STATE MpgResetKey_M 13
IF (SV_USB_MPG_SCALE_SELECT == 1000) THEN SET UsbMpgSpinWheelSelect_M
IF (SV_USB_MPG_SCALE_SELECT != 1000) THEN RST UsbMpgSpinWheelSelect_M
IF (SV_USB_MPG_SCALE_SELECT == 10000) THEN SET UsbMpgFeedWheelSelect_M
IF (SV_USB_MPG_SCALE_SELECT != 10000) THEN RST UsbMpgFeedWheelSelect_M

;Handle jog keys for MPGKey
;Reset all keys first
IF !((SV_USB_MPG_AXIS_SELECT == 1) && UsbMpgJogPlus_M) THEN RST UsbMpgAxis1JogPlus_M
IF !((SV_USB_MPG_AXIS_SELECT == 1) && UsbMpgJogMinus_M) THEN RST UsbMpgAxis1JogMinus_M
IF !((SV_USB_MPG_AXIS_SELECT == 2) && UsbMpgJogPlus_M) THEN RST UsbMpgAxis2JogPlus_M
IF !((SV_USB_MPG_AXIS_SELECT == 2) && UsbMpgJogMinus_M) THEN RST UsbMpgAxis2JogMinus_M
IF !((SV_USB_MPG_AXIS_SELECT == 3) && UsbMpgJogPlus_M) THEN RST UsbMpgAxis3JogPlus_M
IF !((SV_USB_MPG_AXIS_SELECT == 3) && UsbMpgJogMinus_M) THEN RST UsbMpgAxis3JogMinus_M
IF !((SV_USB_MPG_AXIS_SELECT == 4) && UsbMpgJogPlus_M) THEN RST UsbMpgAxis4JogPlus_M
IF !((SV_USB_MPG_AXIS_SELECT == 4) && UsbMpgJogMinus_M) THEN RST UsbMpgAxis4JogMinus_M
IF !((SV_USB_MPG_AXIS_SELECT == 5) && UsbMpgJogPlus_M) THEN RST UsbMpgAxis5JogPlus_M
IF !((SV_USB_MPG_AXIS_SELECT == 5) && UsbMpgJogMinus_M) THEN RST UsbMpgAxis5JogMinus_M
IF !((SV_USB_MPG_AXIS_SELECT == 6) && UsbMpgJogPlus_M) THEN RST UsbMpgAxis6JogPlus_M
IF !((SV_USB_MPG_AXIS_SELECT == 6) && UsbMpgJogMinus_M) THEN RST UsbMpgAxis6JogMinus_M
IF !((SV_USB_MPG_AXIS_SELECT == 7) && UsbMpgJogPlus_M) THEN RST UsbMpgAxis7JogPlus_M
IF !((SV_USB_MPG_AXIS_SELECT == 7) && UsbMpgJogMinus_M) THEN RST UsbMpgAxis7JogMinus_M
IF !((SV_USB_MPG_AXIS_SELECT == 8) && UsbMpgJogPlus_M) THEN RST UsbMpgAxis8JogPlus_M
IF !((SV_USB_MPG_AXIS_SELECT == 8) && UsbMpgJogMinus_M) THEN RST UsbMpgAxis8JogMinus_M

;Set Appropriate key
IF ((SV_USB_MPG_AXIS_SELECT == 1) && UsbMpgJogPlus_M) THEN SET UsbMpgAxis1JogPlus_M
IF ((SV_USB_MPG_AXIS_SELECT == 1) && UsbMpgJogMinus_M) THEN SET UsbMpgAxis1JogMinus_M
IF ((SV_USB_MPG_AXIS_SELECT == 2) && UsbMpgJogPlus_M) THEN SET UsbMpgAxis2JogPlus_M
IF ((SV_USB_MPG_AXIS_SELECT == 2) && UsbMpgJogMinus_M) THEN SET UsbMpgAxis2JogMinus_M
IF ((SV_USB_MPG_AXIS_SELECT == 3) && UsbMpgJogPlus_M) THEN SET UsbMpgAxis3JogPlus_M
IF ((SV_USB_MPG_AXIS_SELECT == 3) && UsbMpgJogMinus_M) THEN SET UsbMpgAxis3JogMinus_M
IF ((SV_USB_MPG_AXIS_SELECT == 4) && UsbMpgJogPlus_M) THEN SET UsbMpgAxis4JogPlus_M
IF ((SV_USB_MPG_AXIS_SELECT == 4) && UsbMpgJogMinus_M) THEN SET UsbMpgAxis4JogMinus_M
IF ((SV_USB_MPG_AXIS_SELECT == 5) && UsbMpgJogPlus_M) THEN SET UsbMpgAxis5JogPlus_M
IF ((SV_USB_MPG_AXIS_SELECT == 5) && UsbMpgJogMinus_M) THEN SET UsbMpgAxis5JogMinus_M
IF ((SV_USB_MPG_AXIS_SELECT == 6) && UsbMpgJogPlus_M) THEN SET UsbMpgAxis6JogPlus_M
IF ((SV_USB_MPG_AXIS_SELECT == 6) && UsbMpgJogMinus_M) THEN SET UsbMpgAxis6JogMinus_M
IF ((SV_USB_MPG_AXIS_SELECT == 7) && UsbMpgJogPlus_M) THEN SET UsbMpgAxis7JogPlus_M
IF ((SV_USB_MPG_AXIS_SELECT == 7) && UsbMpgJogMinus_M) THEN SET UsbMpgAxis7JogMinus_M
IF ((SV_USB_MPG_AXIS_SELECT == 8) && UsbMpgJogPlus_M) THEN SET UsbMpgAxis8JogPlus_M
IF ((SV_USB_MPG_AXIS_SELECT == 8) && UsbMpgJogMinus_M) THEN SET UsbMpgAxis8JogMinus_M

;Set Part Zero
IF MpgSetAxisZero_M && UsbMpgAxis1Active_M && UsbMpgAxis1Selected_M &&
  !UsbMpgFeedWheelSelect_M THEN (SetAxis1Part0_SV)
IF MpgSetAxisZero_M && UsbMpgAxis2Active_M && UsbMpgAxis2Selected_M &&
  !UsbMpgFeedWheelSelect_M THEN (SetAxis2Part0_SV)
IF MpgSetAxisZero_M && UsbMpgAxis3Active_M && UsbMpgAxis3Selected_M &&
  !UsbMpgFeedWheelSelect_M THEN (SetAxis3Part0_SV)
IF MpgSetAxisZero_M && UsbMpgAxis4Active_M && UsbMpgAxis4Selected_M &&
  !UsbMpgFeedWheelSelect_M THEN (SetAxis4Part0_SV)
IF MpgSetAxisZero_M && UsbMpgAxis5Active_M && UsbMpgAxis5Selected_M &&
  !UsbMpgFeedWheelSelect_M THEN (SetAxis5Part0_SV)
IF MpgSetAxisZero_M && UsbMpgAxis6Active_M && UsbMpgAxis6Selected_M &&
  !UsbMpgFeedWheelSelect_M THEN (SetAxis6Part0_SV)
IF MpgSetAxisZero_M && UsbMpgAxis7Active_M && UsbMpgAxis7Selected_M &&
  !UsbMpgFeedWheelSelect_M THEN (SetAxis7Part0_SV)
IF MpgSetAxisZero_M && UsbMpgAxis8Active_M && UsbMpgAxis8Selected_M &&
  !UsbMpgFeedWheelSelect_M THEN (SetAxis8Part0_SV)

;MPG Macro Keys
;By setting SV_SYS_MACRO to a value of something other than zero, the PLC is 
;requesting CNC12 to run the corresponding macro in the c:\cncm\system directory
;Setting SV_SYS_MACRO = 1, run c:\cncm\system\MPGmacro1.mac. Cnc12 will not run the
;same macro twice in a row unless SV_SYS_MACRO has been set to 0 between requests.
IF MpgMacro1_M THEN SV_SYS_MACRO = 1
IF MpgMacro2_M THEN SV_SYS_MACRO = 2
IF MpgMacro3_M THEN SV_SYS_MACRO = 3
IF MpgMacro4_M THEN SV_SYS_MACRO = 4

IF ! (MpgMacro1_M || MpgMacro2_M ||
      MpgMacro3_M || MpgMacro4_M) THEN NoMacroKeyPressedTimer_T = 100,
                                       SET NoMacroKeyPressedTimer_T
IF NoMacroKeyPressedTimer_T THEN SV_SYS_MACRO = 0,
                               RST NoMacroKeyPressedTimer_T
  
;------------------------------------------------------------------------------
;                             End USB Mpg Section
;------------------------------------------------------------------------------

;--Worklight
;IF (Aux7Key_I || SkinAux7_M_SV || KbAux7Key_M) THEN (Aux7_PD)
;IF (Aux7_PD ^ Aux7LED_O) || OnAtPowerUp_M THEN (Aux7LED_O)
;IF Aux7LED_O THEN (WorkLightOut_O)       

;--Process important Keyboard keys all the time
;--Cycle Cancel (ESC)
IF Kb_Escape_SV THEN (KbCycleCancel_M)

;KbFeedHold_M (spacebar)
IF Kb_spacebar_SV && AllowKbInput_M && SV_PROGRAM_RUNNING THEN (KbFeedHold_M)

IF SV_PC_VIRTUAL_JOGPANEL_ACTIVE THEN (KbJpActive_M)

;Call KeyboardEventsStage if needed
IF Kb_L_Ctrl_SV || Kb_R_Ctrl_SV ||
   Kb_L_Shift_SV || Kb_R_Shift_SV ||
   Kb_R_Alt_SV || Kb_L_Alt_SV || KbJpActive_M
  THEN SET KeyboardEventsStage

IF (Kb_L_Ctrl_SV || Kb_R_Ctrl_SV || Kb_L_Shift_SV || Kb_R_Shift_SV || Kb_R_Alt_SV || Kb_L_Alt_SV)
   && (Kb_j_SV || Kb_f_SV || Kb_a_SV || Kb_s_SV) && !AllowKbInput_M
  THEN InfoMsg_W = KB_JOG_MSG_C

;--Handle Faults
IF !EStopOk_M || PLCFault_M || SV_STALL_ERROR || SpindleFault_M || AC1FatalError_M ||
   LubeFault_M || AxisFault_M || ProbeFault_M || OtherFault_M THEN SET SV_STOP

IF SV_STOP THEN RST SV_MASTER_ENABLE

IF !EStopOk_M THEN RST SV_STALL_ERROR,
                   RST LubeFault_M,
                   RST SpindleFault_M,
                   RST OtherFault_M,
                   RST ProbeFault_M,
                   RST ProbeMsgSent_M,
				   RST AxisFault_M
				 
;IF Initialize_T && !LubeOk_I && !SV_PROGRAM_RUNNING
;  THEN SET LubeFault_M, FaultMsg_W = LUBE_FAULT_MSG_C

;IF !LubeOk_I THEN (LowLubePD_PD)
;IF LowLubePD_PD && SV_PROGRAM_RUNNING THEN InfoMsg_W = LUBE_WARNING_MSG_C


IF Initialize_T && !SpindleInverterOk_I
  THEN FaultMsg_W = SPINDLE_FAULT_MSG_C, SET SpindleFault_M
IF !EStopOk_M && !SpindleInverterOk_I THEN (InverterResetOut_O)

;OpticDirect bits
; SV_DRIVE_CONTROL_1
;  7 = POS_CLR, 8 = P-OT, 9 = N-OT, 10 = /P-CON, 11 = /P-CL, 12 = /N-CL,
;  13 = ABS. send, 14 = Alarm reset, 15 = enable
IF !EStopOK_M THEN BITSET SV_Control_1_Shadow_W 14,
                   BITSET SV_Control_2_Shadow_W 14,
                   BITSET SV_Control_3_Shadow_W 14,
                   BITSET SV_Control_4_Shadow_W 14,
                   BITSET SV_Control_5_Shadow_W 14,
                   BITSET SV_Control_6_Shadow_W 14,
                   BITSET SV_Control_7_Shadow_W 14,
                   BITSET SV_Control_8_Shadow_W 14,
                   BITRST SV_Control_1_Shadow_W 7,
                   BITRST SV_Control_2_Shadow_W 7,
                   BITRST SV_Control_3_Shadow_W 7,
                   BITRST SV_Control_4_Shadow_W 7,
                   BITRST SV_Control_5_Shadow_W 7,
                   BITRST SV_Control_6_Shadow_W 7,
                   BITRST SV_Control_7_Shadow_W 7,
                   BITRST SV_Control_8_Shadow_W 7

IF EStopOK_M THEN BITRST SV_Control_1_Shadow_W 14,
                  BITRST SV_Control_2_Shadow_W 14,
                  BITRST SV_Control_3_Shadow_W 14,
                  BITRST SV_Control_4_Shadow_W 14,
                  BITRST SV_Control_5_Shadow_W 14,
                  BITRST SV_Control_6_Shadow_W 14,
                  BITRST SV_Control_7_Shadow_W 14,
                  BITRST SV_Control_8_Shadow_W 14,
                  BITSET SV_Control_1_Shadow_W 7,
                  BITSET SV_Control_2_Shadow_W 7,
                  BITSET SV_Control_3_Shadow_W 7,
                  BITSET SV_Control_4_Shadow_W 7,
                  BITSET SV_Control_5_Shadow_W 7,
                  BITSET SV_Control_6_Shadow_W 7,
                  BITSET SV_Control_7_Shadow_W 7,
                  BITSET SV_Control_8_Shadow_W 7

IF True_M THEN SV_DRIVE_CONTROL_1 = SV_Control_1_Shadow_W,
               SV_DRIVE_CONTROL_2 = SV_Control_2_Shadow_W,
               SV_DRIVE_CONTROL_3 = SV_Control_3_Shadow_W,
               SV_DRIVE_CONTROL_4 = SV_Control_4_Shadow_W,
               SV_DRIVE_CONTROL_5 = SV_Control_5_Shadow_W,
               SV_DRIVE_CONTROL_6 = SV_Control_6_Shadow_W,
               SV_DRIVE_CONTROL_7 = SV_Control_7_Shadow_W,
               SV_DRIVE_CONTROL_8 = SV_Control_8_Shadow_W 

; Echo some system variables to memory bits, for troubleshooting only
IF SV_MASTER_ENABLE THEN (MasterEnable_M)
IF SV_STALL_ERROR THEN (Stall_M),
                       StallReason_W = SV_STALL_REASON,
                       StallAxis_W = SV_STALL_AXIS
IF SV_STOP THEN (Stop_M)

IF !SV_STOP THEN (NoFaultOut_O)

; Reset faults if E-stop is released and no fault condition persists
IF EStopOk_M &&
   !(PLCFault_M || SV_STALL_ERROR || SpindleFault_M || LubeFault_M || AC1FatalError_M ||
     AxisFault_M || OtherFault_M || SoftwareNotReady_M || PLCExecutorFault_M)
  THEN RST SV_STOP

; Automatically reset non-fault errors after a short time
IF ErrorFlag_M THEN SET ErrorFlag_T
IF ErrorFlag_T THEN RST ErrorFlag_M, RST ErrorFlag_T

IF ProbeFault_M && !ProbeMsgSent_M
  THEN FaultMsg_W = PROBE_FAULT_MSG_C, SET ProbeMsgSent_M

;--M-Codes
; Reset these M-codes if not in CNC Program Running mode
IF !SV_PROGRAM_RUNNING
  THEN RST M3_SV,
       RST M4_SV,
       RST M8_SV,
       RST M7_SV,
       RST M10_SV

; Detect auto spindle and coolant requests during manual modes
IF M3_SV || M4_SV THEN (AutoSpindlePD_PD)
IF AutoSpindlePD_PD && !SpinAutoModeLED_O
  THEN SET ActivateFeedHold_M,
       InfoMsg_W = AUTO_SPINDLE_PROMPT_C

IF M7_SV || M8_SV THEN (AutoCoolantPD_PD)
IF AutoCoolantPD_PD && !CoolAutoModeLED_O
  THEN SET ActivateFeedHold_M,
       InfoMsg_W = AUTO_COOLANT_PROMPT_C

IF ActivateFeedHold_M THEN TriggerPause_T=100, SET TriggerPause_T
IF TriggerPause_T THEN RST TriggerPause_T, RST ActivateFeedHold_M

IF True_M THEN SvToolNum_W = SV_TOOL_NUMBER

;------------------------------------------------------------------------------
;                            Tool Clamp/Unclamp
;------------------------------------------------------------------------------
IF !SV_STOP && ZeroSpeed_I && (ToolRelease_I || (M15_SV && SV_PROGRAM_RUNNING)) 
  THEN SET ToolUnclampOut_O, SET UnclampingTool_M, SET ToolClampUnclampTimer_T
  
IF ToolUnclampOut_O THEN (AirBlow_O)  
  
IF (UnclampingTool_M && ToolUnclamped_I) 
  THEN RST ToolClampUnclampTimer_T
  
IF !ToolRelease_I && !M15_SV 
  THEN RST ToolUnclampOut_O, RST UnclampingTool_M, RST ToolClampUnclampTimer_T    
  
IF !SV_PROGRAM_RUNNING THEN RST M15_SV  

IF ToolClampUnclampTimer_T 
  THEN FaultMsg_W = TOOL_CLAMP_UNCLAMP_FAULT_C, SET OtherFault_M

;------------------------------------------------------------------------------
;                            Spindle Orient
;------------------------------------------------------------------------------
;IF M19_SV THEN (OrientRequest_O)
;IF OrientRequest_O THEN SET OrientTimer_T
;IF OrientRequest_O && OrientComplete_I THEN SET MonitorOrient_M, RST OrientTimer_T 
;IF OrientRequest_O && !OrientComplete_I && MonitorOrient_M 
;THEN SET OrientLostTimer_T
;IF OrientComplete_I THEN RST OrientLostTimer_T  
;  
;IF ToolUnclampOut_O || !SV_PROGRAM_RUNNING || !M19_SV
;  THEN RST M19_SV, RST OrientRequest_O, RST MonitorOrient_M, RST OrientLostTimer_T,
;  RST OrientTimer_T
;
;IF OrientLostTimer_T THEN FaultMsg_W = ORIENT_LOST_FAULT_C, SET OtherFault_M  
;IF OrientTimer_T THEN FaultMsg_W = ORIENT_TIMEOUT_C, SET OtherFault_M
;
;------------------------------------------------------------------------------
;                            Spindle Fan
;------------------------------------------------------------------------------
;Spindle Fan enables with Spindle, then delay turn off by P997 to allow spindle
; fan to cool spindle after.
;IF SpindleEnableOut_O THEN SET SpindleFan_O, RST SpindleFan_T
;IF !SpindleEnableOut_O THEN SET SpindleFan_T
;IF SpindleFan_T THEN RST SpindleFan_O

;------------------------------------------------------------------------------
;                            ATC Carousel
;------------------------------------------------------------------------------
;Carousel In
;IF ZeroSpeed_I && ((OrientComplete_I && M80_SV && M6_SV) || (M80_SV && Aux14Key_I))
;  THEN RST M81_SV, SET CarouselInSol_O, SET CarouselInOutTimer_T, 
;  SET MovingCarouselIn_M, RST MovingCarouselOut_M
;  
;IF SV_STOP || !SV_PROGRAM_RUNNING || (MovingCarouselIn_M && CarouselIsIn_I)
;  THEN RST CarouselInSol_O, RST M80_SV 
;
;;CarouselOut
;IF (M81_SV && M6_SV) || (M81_SV && Aux14Key_I)
;  THEN RST M80_SV, SET CarouselOutSol_O, SET CarouselInOutTimer_T, 
;  SET MovingCarouselOut_M, RST MovingCarouselIn_M
;  
;IF SV_STOP || !SV_PROGRAM_RUNNING || (MovingCarouselOut_M && CarouselIsOut_I)
;  THEN RST CarouselOutSol_O, RST M81_SV  
;  
;;RST Timer on successful completion, job cancellation or fault
;IF SV_STOP || !SV_PROGRAM_RUNNING || (MovingCarouselIn_M && CarouselIsIn_I) || 
;  (MovingCarouselOut_M && CarouselIsOut_I)
;  THEN RST CarouselInOutTimer_T, RST MovingCarouselIn_M, RST MovingCarouselOut_M 
;
;IF (MovingCarouselIn_M && CarouselInOutTimer_T) || 
;  (MovingCarouselOut_M && CarouselInOutTimer_T) 
;  THEN FaultMsg_W = CAROUSEL_IN_OUT_TIME_OUT_C, SET OtherFault_M 
;
;;AirPressure Fault
;IF !AirPressureOk_I && (ToolUnclampOut_O || M80_SV || M81_SV) THEN SET AirPressureLost_T
;IF AirPressureOk_I THEN RST AirPressureLost_T
;IF AirPressureOk_I THEN FaultMsg_W = LOW_AIR_FAULT_C, SET OtherFault_M
;
;;--turn off default setup variable
;IF True_M THEN RST OnAtPowerUp_M
;
;-------------------------------------------------------------------------------
;					       Reference Fence Section
;-------------------------------------------------------------------------------
;Drive left reference fence up


;==============================================================================
                        MonitorIndexATCRequestStage
;==============================================================================
IF DoAux8Key_SV && !SV_STOP THEN (Aux8_PD)
IF (Aux8_PD && !DoingIndex_M) && (!SV_PROGRAM_RUNNING ||(SV_MDI_MODE && 
  SV_PROGRAM_RUNNING && !DoingM6_M)) 
  THEN SET DoingIndexMinus_M, SET DoingIndex_M, SET SetRequestedBinPositionStage  

IF DoAux9Key_SV && !SV_STOP THEN (Aux9_PD)  
IF (Aux9_PD && !DoingIndex_M) && (!SV_PROGRAM_RUNNING ||(SV_MDI_MODE && 
  SV_PROGRAM_RUNNING && !DoingM6_M)) 
  THEN SET DoingIndexPlus_M, SET DoingIndex_M, SET SetRequestedBinPositionStage

IF (Aux8_PD || Aux9_PD) && M6_SV
  THEN InfoMsg_W = MANUAL_INDEX_WHILE_ATC_C, RST DoingIndex_M   

IF M6_SV && !DoingIndex_M 
  THEN (M6PD_PD)
  
IF M6_SV && (DoingIndexMinus_M || DoingIndexPlus_M)
  THEN RST M6_SV, InfoMsg_W = ATC_WHILE_MANUAL_INDEX_C 
  
IF M6PD_PD THEN SET DoingM6_M, SET SetRequestedBinPositionStage

;==============================================================================
                         ReportCarouselPositionStage
;==============================================================================
;Note: When carousel direction is reversed, CarouselReversed_M is set to ignore
;the first count. CarouselReversed_M is then reset and counting is resumed.

;IF True_M THEN MaxBinLocation_W = SV_MACHINE_PARAMETER_161
;IF CarouselEnable_O && !ToolCounter_I THEN SET ToolCounterArmed_M 
;IF CarouselEnable_O && ToolCounter_I && ToolCounterArmed_M 
;  THEN (ToolCounterPD_PD), RST ToolCounterArmed_M
;
;;Determine if we need to Skip Count
;IF ToolCounterPD_PD && ((!CarouselCCW_O && (LastCarouselDir_W == 1)) ||
;  (CarouselCCW_O && LastCarouselDir_W == 0))
;  THEN RST CarouselReversed_M
;
;IF ToolCounterPD_PD && ((!CarouselCCW_O && (LastCarouselDir_W != 1)) ||
;  (CarouselCCW_O && LastCarouselDir_W != 0))
;  THEN SET CarouselReversed_M 
;
;IF ToolCounterPD_PD && !CarouselCCW_O THEN LastCarouselDir_W = 1   
;IF ToolCounterPD_PD && CarouselCCW_O THEN LastCarouselDir_W = 0
;
;;Save LastCarouselDir_W to nonvolitile memory
;IF ToolCounterPD_PD THEN SV_NV_W1 = LastCarouselDir_W
;
;;Do not Skip Count if Parameter 852 is not set.
;IF SV_MACHINE_PARAMETER_852 == 0 THEN RST CarouselReversed_M
;
;IF ToolCounterPD_PD && CarouselCCW_O && !CarouselReversed_M
;  THEN CarouselPosition_W = CarouselPosition_W - 1
;IF ToolCounterPD_PD && !CarouselCCW_O && !CarouselReversed_M 
;  THEN CarouselPosition_W = CarouselPosition_W + 1
;
;IF CarouselPosition_W > MaxBinLocation_W THEN CarouselPosition_W = 1  
;IF CarouselPosition_W < 1 THEN CarouselPosition_W = MaxBinLocation_W
;
;;Initalize ATC Based on Parameter 164 Setting.
;IF M18_SV && (SV_MACHINE_PARAMETER_164 == 0) THEN CarouselPosition_W = 1,
;                                                  RequestedBinPosition_W = 1,
;                                                  PutBackPosition_W = 1
;IF M18_SV && (SV_MACHINE_PARAMETER_164 != 0) THEN CarouselPosition_W = SV_ATC_CAROUSEL_POSITION,
;                                                  RequestedBinPosition_W = 1,
;                                                  PutBackPosition_W = SV_ATC_TOOL_IN_SPINDLE
;
;IF !SV_PROGRAM_RUNNING THEN RST M18_SV, RST DoingM18_M
;
;IF True_M THEN SV_PLC_CAROUSEL_POSITION = CarouselPosition_W
;
;;==============================================================================
;                       SetRequestedBinPositionStage
;;==============================================================================
;IF DoingIndexPlus_M THEN RequestedBinPosition_W = CarouselPosition_W + 1 
;IF DoingIndexMinus_M THEN RequestedBinPosition_W = CarouselPosition_W - 1
;IF DoingIndex_M && (RequestedBinPosition_W > MaxBinLocation_W)
;  THEN RequestedBinPosition_W = 1 
;IF DoingIndex_M && (RequestedBinPosition_W < 1) 
;  THEN RequestedBinPosition_W = MaxBinLocation_W   
;
;IF DoingM6_M && (CarouselPosition_W == PutBackPosition_W)   
;  THEN RequestedBinPosition_W = SV_TOOL_NUMBER, 
;  SET AtPutbackLocation_M, SET WaitingForPutbackComplete_M
;  
;IF DoingM6_M && RequestedBinPosition_W - 1 != CarouselPosition_W
;  THEN SET WTF_M   
;  
;IF PutBackPosition_W == 0 THEN RST WaitingForPutbackComplete_M  
;  
;IF DoingM6_M && (CarouselPosition_W != PutBackPosition_W) &&
;  ((PutBackPosition_W != 0) && DoingM6_M) 
;  THEN RequestedBinPosition_W = PutBackPosition_W, SET DoingPutback_M
;
;IF True_M THEN RST DoingIndexMinus_M, RST DoingIndexPlus_M, JMP SetCarouselDirectionStage
;
;;==============================================================================
;                        SetCarouselDirectionStage
;;==============================================================================
;;CW 1-2-3
;IF ((RequestedBinPosition_W > CarouselPosition_W) && 
; (RequestedBinPosition_W - CarouselPosition_W <= (MaxBinLocation_W / 2))) ||
; ((RequestedBinPosition_W < CarouselPosition_W) &&
; (CarouselPosition_W - RequestedBinPosition_W > (MaxBinLocation_W / 2)))
; THEN RST CarouselCCW_O
;
;;CCW 3-2-1
;IF M18_SV || (((RequestedBinPosition_W < CarouselPosition_W) && 
; (CarouselPosition_W - RequestedBinPosition_W <= (MaxBinLocation_W / 2))) ||
; ((RequestedBinPosition_W > CarouselPosition_W) &&
; (RequestedBinPosition_W - CarouselPosition_W > (MaxBinLocation_W / 2))))
; THEN SET CarouselCCW_O
; 
;IF True_M THEN JMP RotateCarouselStage 
; 
;;==============================================================================
;                             RotateCarouselStage
;;==============================================================================
;IF (DoingM6_M || DoingIndex_M) && (RequestedBinPosition_W != CarouselPosition_W) &&
;  !WaitingForPutbackComplete_M
;  THEN SET CarouselEnable_O
;  
;IF DoingPutback_M && CarouselEnable_O THEN SET WaitingForPutbackComplete_M
;IF PutbackComplete_SV || !SV_PROGRAM_RUNNING THEN RST DoingPutback_M, RST WaitingForPutbackComplete_M  
;  
;IF (RequestedBinPosition_W == CarouselPosition_W)
;  THEN RST CarouselEnable_O
;
;IF (RequestedBinPosition_W == CarouselPosition_W) && DoingM6_M && 
;  !CarouselEnable_O && !AtPutbackLocation_M
;  THEN JMP SetRequestedBinPositionStage
;  
;IF (RequestedBinPosition_W == CarouselPosition_W) && DoingM6_M &&  
;  AtPutbackLocation_M && !AtRequestedToolLocation_M && PutbackComplete_SV
;  THEN SET AtRequestedToolLocation_M, SET ToolChangeComplete_M  
;  
;IF ((RequestedBinPosition_W == CarouselPosition_W) && DoingM6_M && AtPutbackLocation_M &&
;  AtRequestedToolLocation_M && ToolChangeComplete_M && !M6_SV) || SV_STOP
;  THEN RST RotateCarouselStage, RST CarouselEnable_O, RST SetCarouselDirectionStage,
;  RST RotateCarouselStage, RST SetRequestedBinPositionStage, RST DoingM6_M, 
;  RST M6_SV, RST AtPutbackLocation_M, RST AtRequestedToolLocation_M, 
;  RST ToolChangeComplete_M, PutBackPosition_W = CarouselPosition_W
;  
;IF (RequestedBinPosition_W == CarouselPosition_W) && DoingIndex_M
;  THEN RST DoingIndex_M  
;
;;==============================================================================
;                            ResetCarouselStage
;;==============================================================================
;IF SV_STOP || (!SV_PROGRAM_RUNNING && M6_SV) 
;  THEN RST DoingIndexMinus_M, RST DoingIndexPlus_M, RST DoingIndex_M,
;  RST CarouselEnable_O, RST SetCarouselDirectionStage, RST RotateCarouselStage,
;  RST SetRequestedBinPositionStage, RST DoingM6_M, RST M6_SV, RST AtPutbackLocation_M,
;  RST AtRequestedToolLocation_M, RST ToolChangeComplete_M, RST DoingPutback_M 
;
;IF !SV_PROGRAM_RUNNING THEN RST CarouselHomeComplete_M, RST DoingM18_M, 
;  RST WaitingForPutbackComplete_M, RST PutbackComplete_SV
;  
;;================================================================
;   SafetySwitchInterruptStage
;;================================================================

IF DoorClosed_I THEN (SafetySwitch_M)
IF !SafetySwitch_M && (SpinStart_M || KbSpinStart_M || M3_SV || M4_SV)
  THEN ErrorMsg_W = SAFETY_SWITCH_SPINDLE_MSG_C, SET ErrorFlag_M

IF !SV_JOB_IN_PROGRESS THEN SET SafetySwitchToolCheck_M
IF !SafetySwitch_M && !SafetySwitchToolCheck_M && SV_JOB_IN_PROGRESS
  && !(M3_SV || M4_SV)
  THEN ErrorMsg_W = SAFETY_SWITCH_OPEN_MSG_C, SET ErrorFlag_M, SET SafetySwitchToolCheck_M

IF SafetySwitch_M THEN RST SafetySwitchToolCheck_M

;================================================================
   MessageStage
;================================================================
IF FaultMsg_W != 0 THEN SET ShowFaultStage
IF FaultMsg_W == 0 && ErrorMsg_W != 0 THEN SET ShowErrorStage, RST ShowInfoStage
IF FaultMsg_W == 0 && !ShowErrorStage && InfoMsg_W != 0 THEN SET ShowInfoStage

;================================================================
   ShowFaultStage
;================================================================
IF !((FaultMsg_W % 256 == 1) || (FaultMsg_W % 256 == 2))
  THEN JMP BadMsgStage
											  
							   
IF True_M THEN MSG FaultMsg_W
IF !EStopOk_M THEN FaultMsg_W = 0,
                 InfoMsg_W = MSG_CLEARED_MSG_C,
                 RST ShowFaultStage

;================================================================
   ShowErrorStage
;================================================================
IF !((ErrorMsg_W % 256 == 1) || (ErrorMsg_W % 256 == 2))
  THEN JMP BadMsgStage
IF True_M THEN MSG ErrorMsg_W, SET MsgClear_T
IF MsgClear_T THEN ErrorMsg_W = 0,
								  
								  
                   RST MsgClear_T,
                   RST ShowErrorStage


;================================================================
   ShowInfoStage
;================================================================
IF !((InfoMsg_W % 256 == 1) || (InfoMsg_W % 256 == 2))
  THEN JMP BadMsgStage
IF True_M THEN MSG InfoMsg_W, SET MsgClear_T
IF MsgClear_T THEN InfoMsg_W = 0,
								 
								 
                   RST MsgClear_T,
                   RST ShowInfoStage

;=============================================================================
   BadMsgStage
;=============================================================================
IF True_M THEN FaultMsg_W = 0,
             ErrorMsg_W = 0,
             InfoMsg_W = BAD_MESSAGE_MSG_C,
             RST BadMsgStage

